// go-with-me hub settings for Zellij (only used by the hub)
//
// "Unlock first" keys: every key goes straight to the program in the tab (Claude, opencode…)
// until you press Ctrl+g. Then single keys work, and the bottom bar shows them, e.g.
//   Ctrl+g  t  then n = new tab · x = close tab · ←/→ = switch tab
//   Ctrl+g  o  then d = leave the hub (everything keeps running)
// Mouse: click a tab to switch, click a pane to focus it, scroll to scroll.
// Shortcuts: one key combo each, no modes. ⌥ = Option (Terminal.app: run `gwm keys --setup` once).
// Picked to avoid Claude Code's own (⌥P, ⌥T, ⌥Enter). `gwm keys` or ⌥/ shows this list.
keybinds preset="unlock-first" {
    locked {
        bind "Alt 1" { GoToTab 1; }
        bind "Alt 2" { GoToTab 2; }
        bind "Alt 3" { GoToTab 3; }
        bind "Alt 4" { GoToTab 4; }
        bind "Alt 5" { GoToTab 5; }
        bind "Alt 6" { GoToTab 6; }
        bind "Alt 7" { GoToTab 7; }
        bind "Alt 8" { GoToTab 8; }
        bind "Alt 9" { GoToTab 9; }
        bind "Alt Left" { GoToPreviousTab; }
        bind "Alt Right" { GoToNextTab; }
        bind "Alt s" { FocusNextPane; }                       // sidebar <-> terminal
        bind "Alt n" { NewPane "Right"; }                     // split: new terminal pane
        bind "Alt x" { CloseFocus; }                          // close the focused pane
        bind "Alt z" { ToggleFocusFullscreen; }               // zoom the focused pane
        bind "Alt o" { Run "bash" "-c" "gwm pick || { echo; read -rp 'Press Enter to close '; }" { floating true; close_on_exit true; name "open a session"; }; }
        bind "Alt q" { Detach; }                              // leave; everything keeps running
        bind "Alt /" { Run "gwm" "keys" { floating true; close_on_exit true; name "shortcuts"; }; }
    }
}

show_startup_tips false
mouse_mode true
pane_frames false
session_serialization false

show_setup_screen false
show_release_notes false

// Copying: select text with the mouse and it's on your clipboard (paste with Cmd+V)
copy_command "pbcopy"
copy_on_select true
