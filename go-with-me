#!/bin/bash
# go-with-me — one terminal for all your machines, accounts, VMs and models.
#
#   "overview" tab: live board of every machine + session, and a coordinator Claude that can see/steer them all.
#   One tab per session. A session = a machine + an engine (claude | opencode | shell) + an account + a folder.
#   Sessions keep running on their machine when you disconnect. The hub runs in Zellij (shortcuts shown on screen).
#
# Hub
#   gwm                               open the hub (or re-attach). Only running sessions get a tab.
#   gwm status | board                one-shot status / live board
#   gwm who                           which other devices are using each machine right now
#   gwm kill                          close the hub (sessions keep running)
#   gwm demo                          try it: the hub with pretend machines (no setup needed)
# Sessions
#   gwm new [name] [--on machine] [--engine e] [--account a] [--folder f]   start a session (asks what's missing)
#   gwm open <session>                open a tab for a session that isn't running/open yet (starts it)
#   gwm close <session> [--yes]       stop a session and remove its tab
#   gwm stop <session>                stop what's running but keep the tab (Enter in the tab restarts it)
#   gwm sessions                      list sessions
#   gwm peek <session> [lines]        show a session's screen
#   gwm send <session> <text...>      type text + Enter into a session
#   gwm attach <session>              connect to a session in this terminal (what each tab runs)
# Machines
#   gwm hosts                         list machines
#   gwm run <host> <command...>       run a shell command on a machine
#   gwm doctor                        check every machine is reachable and ready
# Accounts (separate Claude logins, e.g. personal + work)
#   gwm accounts [--on host]          show which account is logged in where
#   gwm login <account> [--on host]   sign an account in on a host
# VMs (Linux, via Lima — run them on your strongest machine)
#   gwm vm create <name> [--on host] [--cpus N] [--memory GB] [--disk GB]
#   gwm vm list|start|stop|delete [name] [--on host]
# Local models (Ollama) + opencode
#   gwm models [--on host]            installed + loaded models
#   gwm pull <model> [--on host]      download a model
#   gwm opencode-setup [--on host] [--model name]   point opencode at that host's Ollama
# Setup
#   gwm init [name]                   one-time on each machine: name it and create its config
#   gwm tailscale                     set up Tailscale + Tailscale SSH on this Mac (then no Remote Login needed)
#   gwm add [--via tailscale|ssh]     add another machine (guided): Tailscale, or Remote Login with SSH keys
#                                     set up both ways; installs tmux + go-with-me there, adds a tab
#   gwm remove <machine>              remove a machine from your config
#   gwm sync <host>                   copy hosts/sessions config from another host
#   gwm edit                          open the config files in your editor

set -u
SCRIPT="$(readlink "$0" 2>/dev/null || echo "$0")"
case "$SCRIPT" in /*) ;; *) SCRIPT="$(cd "$(dirname "$0")" && pwd)/$(basename "$SCRIPT")";; esac
DIR="$(cd "$(dirname "$SCRIPT")" && pwd)"
ME="$DIR/go-with-me"
CFG="${GWM_CONFIG:-$HOME/.config/go-with-me}"
if [ "${1:-}" = demo ]; then   # `gwm demo`: the real hub with pretend machines — no SSH, no logins, nothing real touched
  export GWM_DEMO=1 GWM_HUB=gwm-demo GWM_CONFIG="${TMPDIR:-/tmp}/go-with-me-demo"
  rm -rf "$GWM_CONFIG"; mkdir -p "$GWM_CONFIG"; cp "$DIR/demo/hosts.conf" "$DIR/demo/sessions.conf" "$GWM_CONFIG/"; echo studio > "$GWM_CONFIG/self"
  CFG="$GWM_CONFIG"; shift; [ $# -gt 0 ] || set -- open   # `gwm demo status` etc. also work on the pretend data
fi
HOSTS="$CFG/hosts.conf"; SESSIONS="$CFG/sessions.conf"; SELF_FILE="$CFG/self"
PFX=gwm-
ACCT_DIR='$HOME/.config/go-with-me/accounts'   # expanded on the target host
export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$PATH"

c() { [ -t 1 ] && printf '\033[%sm' "$1" || true; }
die() { echo "go-with-me: $*" >&2; exit 1; }
b64() { printf '%s' "$1" | base64 | tr -d '\n'; }
self_name() { [ -f "$SELF_FILE" ] && cat "$SELF_FILE" || true; }

# ---------- config ----------
rows() {  # rows <file> <ncols>  → tab-separated, trimmed, comments skipped
  [ -f "$1" ] || die "missing $1 — run: gwm init <this-host-name>"
  awk -F'|' -v n="$2" '/^[[:space:]]*#/||/^[[:space:]]*$/{next}
    {o=""; for(i=1;i<=n;i++){v=$i; gsub(/^[[:space:]]+|[[:space:]]+$/,"",v); o=o (i>1?"\t":"") v} print o}' "$1"
}
hosts()    { rows "$HOSTS" 3; }      # name target role
sessions() { rows "$SESSIONS" 5; }   # name host engine account folder
hfield() { hosts    | awk -F'\t' -v n="$1" -v f="$2" '$1==n{print $f; ok=1} END{exit !ok}'; }
sfield() { sessions | awk -F'\t' -v n="$1" -v f="$2" '$1==n{print $f; ok=1} END{exit !ok}'; }
need_host()    { hfield "$1" 1 >/dev/null || die "unknown host '$1' (gwm hosts)"; }
need_session() { sfield "$1" 1 >/dev/null || die "unknown session '$1' (gwm sessions)"; }
is_local() { [ "$1" = "$(self_name)" ]; }

# ---------- running things on hosts ----------
# run_script <host> <script>   non-interactive; works for this machine, SSH hosts and Lima VMs
PATHFIX='export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"'
run_script() {
  [ -n "${GWM_DEMO:-}" ] && return 0
  local h="$1" s="$PATHFIX
$2" t; t="$(hfield "$h" 2)"
  case "$t" in
    vm:*) local parent="${t#vm:}"; parent="${parent%%/*}"; local vm="${t#*/}"
          run_script "$parent" "limactl shell --workdir / $vm -- bash -l -c \"\$(printf %s $(b64 "$s") | base64 -d)\"" ;;
    *) if is_local "$h"; then printf '%s\n' "$s" | env -u TMUX "${SHELL:-/bin/zsh}" -l -s
       else printf '%s\n' "$s" | ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ConnectTimeout=4 -o ServerAliveInterval=5 \
              -o ServerAliveCountMax=2 -o LogLevel=ERROR "$t" 'exec "$SHELL" -l -s'; fi ;;
  esac
}
# run_tty <host> <command>   interactive (needs a terminal)
run_tty() {
  local h="$1" s="$PATHFIX; $2" t; t="$(hfield "$h" 2)"
  case "$t" in
    vm:*) local parent="${t#vm:}"; parent="${parent%%/*}"; local vm="${t#*/}"
          run_tty "$parent" "limactl shell --workdir / $vm -- bash -l -c \"\$(printf %s $(b64 "$s") | base64 -d)\"" ;;
    *) if is_local "$h"; then env -u TMUX "${SHELL:-/bin/zsh}" -lc "$s"
       else ssh -t -o StrictHostKeyChecking=accept-new -o ConnectTimeout=5 -o ServerAliveInterval=10 -o ServerAliveCountMax=3 -o LogLevel=ERROR \
              "$t" "exec \"\$SHELL\" -lc \"\$(printf %s $(b64 "$s") | base64 -d)\""; fi ;;
  esac
}
# --on <host> option parsing (default: this machine)
ON=""; ARGS=()
parse_on() { ON="$(self_name)"; ARGS=(); while [ $# -gt 0 ]; do
  case "$1" in --on) ON="$2"; shift 2;; *) ARGS+=("$1"); shift;; esac; done; need_host "$ON"; }

# ---------- status ----------
PROBE='
if [ "$(uname)" = Darwin ]; then
  cpu=$(top -l 2 -n 0 -s 1 2>/dev/null | awk "/CPU usage/{u=\$3+\$5} END{printf \"%d%%\", u}")
  pg=$(sysctl -n hw.pagesize); tot=$(( $(sysctl -n hw.memsize) / 1073741824 ))
  used=$(vm_stat | awk -v ps=$pg "/Anonymous pages/{a=\$3} /wired down/{w=\$4} /occupied by compressor/{c=\$5} END{gsub(/\\./,\"\",a);gsub(/\\./,\"\",w);gsub(/\\./,\"\",c); printf \"%.0f\", (a+w+c)*ps/1073741824}")
else
  read -r _ a b c d _ < /proc/stat; sleep 1; read -r _ a2 b2 c2 d2 _ < /proc/stat
  cpu="$(( 100 * ((a2+b2+c2)-(a+b+c)) / ((a2+b2+c2+d2)-(a+b+c+d) + 1) ))%"
  tot=$(awk "/MemTotal/{printf \"%.0f\", \$2/1048576}" /proc/meminfo)
  used=$(awk "/MemTotal/{t=\$2} /MemAvailable/{a=\$2} END{printf \"%.0f\", (t-a)/1048576}" /proc/meminfo)
fi
models=$(curl -s -m 1 http://127.0.0.1:11434/api/ps 2>/dev/null | grep -o "\"name\":\"[^\"]*\"" | cut -d\" -f4 | sort -u | paste -sd, -)
vms=$(command -v limactl >/dev/null && limactl list --format "{{.Name}}:{{.Status}}" 2>/dev/null | paste -sd, -)
echo "H|$cpu|$used/${tot}G|${models:--}|${vms:-}"
if command -v tmux >/dev/null; then
  now=$(date +%s)
  tmux list-sessions -F "#{session_name}|#{session_activity}|#{session_attached}|#{pane_title}" 2>/dev/null | grep "^gwm-" |
  while IFS="|" read -r n act att title; do echo "S|${n#gwm-}|$((now-act))|$att|$(echo "$title" | tr "|" "/")"; done
fi
if [ "$(uname)" = Darwin ]; then
  # who is using this machine over SSH: T = interactive terminals (tabs), C = all SSH connections, per source IP
  who | sed -n "s/.*(\(.*\))\$/\1/p" | sed "s/%.*//; s/^fe80:[0-9a-f]*::/fe80::/" | sort | uniq -c | while read -r k ip; do echo "T|$ip|$k"; done
  lsof -nP -iTCP:22 -sTCP:ESTABLISHED 2>/dev/null | awk "NR>1 && \$1 ~ /sshd/ {print \$9}" | sort -u | sed "s/.*->//" |
    sed "s/:[0-9]*\$//; s/^\[//; s/\]\$//; s/^fe80:[0-9a-f]*::/fe80::/" | sort | uniq -c | while read -r k ip; do echo "C|$ip|$k"; done
  # Tailscale SSH logins run as: /usr/bin/login -f -pq -h <their tailscale ip> ...  (one per connection)
  ps -axo tty=,command= | awk "/\/usr\/bin\/login -f .* -h [0-9a-f.:]+ / {for(i=1;i<=NF;i++) if(\$i==\"-h\") print \$1, \$(i+1)}" |
    while read -r tt ip; do echo "C|$ip|1"; [ "$tt" != "??" ] && echo "T|$ip|1"; done
  # this machine own addresses, so connections from other machines can be named
  echo "I|$( { ifconfig 2>/dev/null | awk "/inet6? /{print \$2}"; tailscale ip 2>/dev/null; } | sed "s/%.*//; s/^fe80:[0-9a-f]*::/fe80::/" | grep -vE "^(127\.|::1\$|fe80::1\$)" | sort -u | paste -sd, -)"
fi
'
demo_probe() {  # fake but lively data for `gwm demo`
  local t=$(( $(date +%s) / 5 )) r=$RANDOM
  echo "studio|H|$((18 + r % 15))%|31/64G|inkling-2-mini|sandbox:Running"
  echo "studio|S|landing-page|$(( t % 3 == 0 ? 40 : 2 ))|1|✳ Building hero section"
  echo "studio|S|local-refactor|840|0|✳ Refactor CLI arg parsing"
  echo "studio|T|10.0.0.3|1"; echo "studio|C|10.0.0.3|1"
  echo "office-1|H|$((64 + r % 20))%|88/128G|qwen3.8-27b,flux-dev|-"
  echo "office-1|S|api-tests|$(( t % 2 == 0 ? 3 : 95 ))|0|✳ Fixing flaky API tests"
  echo "macbook|H|$((6 + r % 6))%|14/24G|-|-"
  echo "sandbox|H|$((3 + r % 4))%|2/8G|-|-"
  echo "sandbox|S|load-test|1500|0|✳ Load test finished"
}
probe_all() {  # → "host|H|..." and "host|S|..." lines, all hosts in parallel
  [ -n "${GWM_DEMO:-}" ] && { demo_probe; return; }
  local tmp; tmp="$(mktemp -d)"
  while IFS=$'\t' read -r h _; do
    ( out="$(run_script "$h" "$PROBE" 2>/dev/null | grep -E '^[HSTCI]\|')"
      [ -n "$out" ] || out="DOWN"; printf '%s\n' "$out" | sed "s/^/$h|/" > "$tmp/$h" ) &
  done < <(hosts)
  wait; cat "$tmp"/* 2>/dev/null; rm -rf "$tmp"
}
ip_map() {  # "ip<TAB>hostname" for every SSH host, resolved from this machine (Bonjour .local names work)
  [ -n "${GWM_DEMO:-}" ] && { printf '10.0.0.3\tmacbook\n'; return; }
  while IFS=$'\t' read -r h t _; do
    case "$t" in vm:*) continue;; esac
    local hn="${t#*@}" ip
    if [[ "$hn" =~ ^[0-9.]+$ ]]; then printf '%s\t%s\n' "$hn" "$h"
    else dscacheutil -q host -a name "$hn" 2>/dev/null | awk -v h="$h" '/ip_address|ipv6_address/{ip=$2; sub(/^fe80:[0-9a-f]*::/,"fe80::",ip); if(ip!="::1" && ip!="127.0.0.1" && ip!="fe80::1") printf "%s\t%s\n", ip, h}'; fi
  done < <(hosts)
}
probe_ip_map() {  # "ip<TAB>host" from each machine's own reported addresses (I| lines)
  grep '|I|' <<<"$1" | while IFS='|' read -r h _ ips; do tr ',' '\n' <<<"$ips" | sed "s/\$/	$h/"; done
}
used_by() {  # used_by <host> <probe data> <ip map>  → "macbook: 2 tabs, 1 agent"
  local h="$1" data="$2" map me; me="$(self_name)"; map="$(probe_ip_map "$data"; printf '%s\n' "$3")"
  grep "^$h|C|" <<<"$data" | awk -F'|' '{n[$3]+=$4} END{for(i in n) print "x|C|" i "|" n[i]}' | while IFS='|' read -r _ _ ip conns; do
    local who tabs agents
    who="$(awk -F'\t' -v ip="$ip" '$1==ip{print $2; exit}' <<<"$map")"; [ -n "$who" ] || who="$ip"
    tabs="$(grep "^$h|T|$ip|" <<<"$data" | awk -F'|' '{t+=$4} END{print t+0}')"
    agents=$((conns - tabs)); [ "$who" = "$me" ] && [ "$h" != "$me" ] && agents=$((agents - 1))   # minus this status check
    [ "$agents" -lt 0 ] && agents=0
    printf '%s %s %s\n' "$who" "$tabs" "$agents"
  done | awk '{t[$1]+=$2; a[$1]+=$3; if(!($1 in o)){o[$1]=++n; k[n]=$1}}
    END{for(i=1;i<=n;i++){w=k[i]; s="";
      if(t[w]>0) s=t[w] " tab" (t[w]>1?"s":"");
      if(a[w]>0) s=s (s?", ":"") a[w] " agent" (a[w]>1?"s":"");
      if(s) out=out (out?"; ":"") w ": " s}
    print out}'
}
probe_cached() {  # probe_cached <max-age-seconds>: one SSH sweep shared by the board and every sidebar
  local cache="$CFG/.probe-cache" lock="$CFG/.probe-lock" age=999 max="${1:-5}"
  [ -f "$cache" ] && age=$(( $(date +%s) - $(stat -f %m "$cache" 2>/dev/null || echo 0) ))
  [ -d "$lock" ] && [ $(( $(date +%s) - $(stat -f %m "$lock" 2>/dev/null || echo 0) )) -gt 60 ] && rmdir "$lock" 2>/dev/null
  if [ "$age" -gt "$max" ] && mkdir "$lock" 2>/dev/null; then
    probe_all > "$cache.tmp.$$" && mv "$cache.tmp.$$" "$cache"; rmdir "$lock" 2>/dev/null
  elif [ ! -f "$cache" ]; then probe_all; return; fi
  cat "$cache"
}
cmd_data() {  # machine-readable state for the sidebar
  local data map; data="$(probe_cached 5)"; map="$(ip_map)"
  printf '#SELF\t%s\n' "$(self_name)"
  hosts | sed 's/^/#HOST	/'; sessions | sed 's/^/#SESS	/'
  while IFS=$'\t' read -r h _; do printf '#USED\t%s\t%s\n' "$h" "$(used_by "$h" "$data" "$map")"; done < <(hosts)
  printf '%s\n' "$data"
}
print_table() {
  local data cols map; data="$(probe_cached "${GWM_MAXAGE:-0}")"; map="$(ip_map)"; cols=$(tput cols 2>/dev/null || echo 140)
  printf "$(c '1;38;5;214')%-12s %-13s %5s %-9s %-22s %-16s %s$(c 0)\n" HOST STATUS CPU RAM "MODELS LOADED" "VMs" "USED BY (other devices)"
  while IFS=$'\t' read -r h t role; do
    line="$(grep "^$h|H|" <<<"$data")"
    if [ -n "$line" ]; then
      IFS='|' read -r _ _ cpu ram models vms <<<"$line"
      st="● on"; is_local "$h" && st="● on (here)"; case "$t" in vm:*) st="● vm";; esac
      ub="$(used_by "$h" "$data" "$map")"
      printf "%-12s $(c 32)%-15s$(c 0) %5s %-9s %-22.22s %-16.16s $(c 35)%s$(c 0)\n" "$h" "$st" "$cpu" "$ram" "$models" "${vms:--}" "${ub:-—}" | cut -c1-$((cols+24))
    else
      printf "%-12s $(c 31)%-15s$(c 0) %s\n" "$h" "○ offline" "asleep / off / not set up → gwm doctor"
    fi
  done < <(hosts)
  echo
  printf "$(c '1;38;5;110')%-14s %-10s %-9s %-10s %-12s %s$(c 0)\n" SESSION HOST ENGINE ACCOUNT STATE "CURRENT TASK"
  while IFS=$'\t' read -r n h e a f; do
    line="$(grep "^$h|S|$n|" <<<"$data")"
    if [ -n "$line" ]; then
      IFS='|' read -r _ _ _ idle att title <<<"$line"
      if [ "$idle" -lt 8 ]; then st="working"; elif [ "$idle" -lt 3600 ]; then st="idle $((idle/60))m"; else st="idle $((idle/3600))h"; fi
      [ "$att" -gt 0 ] && st="$st *"
      col=32; [ "${st%% *}" = working ] && col=33
      printf "%-14s %-10s %-9s %-10s $(c $col)%-12s$(c 0) %s\n" "$n" "$h" "$e" "$a" "$st" "$title" | cut -c1-$((cols+12))
    elif grep -q "^$h|H|" <<<"$data"; then
      printf "%-14s %-10s %-9s %-10s $(c 2)%-12s %s$(c 0)\n" "$n" "$h" "$e" "$a" "not running" "→ gwm open $n"
    else
      printf "%-14s %-10s %-9s %-10s $(c 31)%-12s$(c 0)\n" "$n" "$h" "$e" "$a" "host offline"
    fi
  done < <(sessions)
}
cmd_board() {
  while true; do
    out="$(GWM_MAXAGE=4 print_table 2>&1)"
    [ "${ZELLIJ_SESSION_NAME:-}" = "$HUBNAME" ] && renumber_tabs   # also fixes numbers after tabs are moved/closed by hand
    clear
    printf "$(c 2)go-with-me · %s · refreshes every 5s · * = someone attached$(c 0)\n\n%s\n" "$(date +%H:%M:%S)" "$out"
    sleep 5
  done
}

# ---------- sessions ----------
start_cmd() {  # the command that creates-or-attaches session <name> on its host
  local n="$1" e a f env="" prog
  e="$(sfield "$n" 3)"; a="$(sfield "$n" 4)"; f="$(sfield "$n" 5)"; [ -n "$f" ] || f="~"
  [ -n "$a" ] && [ "$a" != default ] && [ "$a" != - ] && env="-e CLAUDE_CONFIG_DIR=$ACCT_DIR/$a"
  case "$e" in
    claude)   prog='claude; exec $SHELL -l' ;;
    opencode) prog='opencode; exec $SHELL -l' ;;
    shell)    prog='exec $SHELL -l' ;;
    *) die "session '$n': unknown engine '$e' (use claude, opencode or shell)" ;;
  esac
  # tmux on the host is only a keep-alive layer: no status bar, no prefix key, so you never have to deal with it
  local quiet="\\; set-option -t $PFX$n status off \\; set-option -t $PFX$n prefix None \\; set-option -t $PFX$n prefix2 None \\; set-option -s escape-time 10"
  [ -n "$env" ] && echo "mkdir -p $ACCT_DIR/$a; cd $f 2>/dev/null || cd; tmux new-session -A -s $PFX$n $env '$prog' $quiet" \
                || echo "cd $f 2>/dev/null || cd; tmux new-session -A -s $PFX$n '$prog' $quiet"
}
cmd_attach() {
  local n="$1" h; need_session "$n"; h="$(sfield "$n" 2)"
  [ -n "${GWM_DEMO:-}" ] && exec bash "$DIR/demo/agent.sh" "$n"
  while true; do
    clear; echo "Connecting to $n on $h …"
    run_tty "$h" "$(start_cmd "$n")"
    echo; echo "$(c 33)Disconnected from $n.$(c 0) If it was running, it keeps running on $h."
    printf "Press Enter to reconnect (to remove this session: gwm close %s): " "$n"; read -r _ || exit 0
  done
}

# ---------- hub (Zellij) ----------
HUBNAME="${GWM_HUB:-gwm}"
hub_running() { zellij list-sessions -n 2>/dev/null | grep -E "^$HUBNAME " | grep -vq EXITED; }
tab_layout() {  # tab_layout <session>  → KDL for one session tab
  local n="$1" h e a; h="$(sfield "$n" 2)"; e="$(sfield "$n" 3)"; a="$(sfield "$n" 4)"
  local label="$n · $e on $h"; [ "$e" = claude ] && label="$label · account: $a"
  printf '  tab name="%s" {\n    pane name="%s" focus=true command="%s" { args "attach" "%s"; }\n  }\n' "$n" "$label" "$ME" "$n"
}
bars() {  # every tab: the go-with-me sidebar on the left (the only navigation), the tab's content on the right
  printf '  default_tab_template {\n    pane split_direction="vertical" {\n'
  printf '      pane size=34 borderless=true command="%s" { args "sidebar"; }\n      children\n    }\n  }\n' "$ME"
}
running_sessions() {  # names of configured sessions that are running right now on their machine
  local data; data="$(probe_all)"
  while IFS=$'\t' read -r n h _; do grep -q "^$h|S|$n|" <<<"$data" && echo "$n"; done < <(sessions)
}
write_layout() {  # only sessions that are already running get a tab; others are opened with `gwm open <name>`
  local i=1 n
  { echo "layout {"; bars
    printf '  tab name="1 overview" focus=true {\n'
    if [ -n "${GWM_DEMO:-}" ]; then printf '    pane focus=true command="bash" { args "%s"; }\n  }\n' "$DIR/demo/coordinator.sh"
    else printf '    pane focus=true command="claude" cwd="%s"\n  }\n' "$DIR/coordinator"; fi
    for n in $(running_sessions); do i=$((i+1)); tab_layout "$n" | sed "1s/tab name=\"$n\"/tab name=\"$i $n\"/"; done
    echo "}"; } > "$CFG/hub-layout.kdl"
}
cmd_open() {
  command -v zellij >/dev/null || die "zellij not installed (brew install zellij)"
  [ -n "$(self_name)" ] || die "run 'gwm init <this-host-name>' first"
  [ "${ZELLIJ_SESSION_NAME:-}" = "$HUBNAME" ] && die "you're already inside the go-with-me hub"
  # don't leak this terminal's Claude Code session markers into the hub's Claude sessions
  for v in $(env | sed -n 's/^\(CLAUDECODE\|CLAUDE_CODE_[A-Z_]*\)=.*/\1/p'); do unset "$v"; done
  if hub_running; then exec zellij attach "$HUBNAME"; fi
  zellij delete-session "$HUBNAME" >/dev/null 2>&1
  echo "Checking which sessions are running…"; write_layout
  exec zellij --config "$DIR/hub.zellij.kdl" --session "$HUBNAME" --new-session-with-layout "$CFG/hub-layout.kdl"
}
hub_tabs() {  # "id<TAB>position<TAB>name-without-number" for every hub tab
  zellij --session "$HUBNAME" action list-tabs 2>/dev/null |
    awk 'NR>1{id=$1; pos=$2; $1=$2=""; sub(/^[[:space:]]+/,""); sub(/^[0-9]+ /,""); printf "%s\t%s\t%s\n", id, pos, $0}'
}
renumber_tabs() {  # keep "N name" in sync with tab positions, so Alt+N always matches the number shown
  hub_running || return 0
  hub_tabs | while IFS=$'\t' read -r id pos name; do
    zellij --session "$HUBNAME" action list-tabs 2>/dev/null | awk -v id="$id" 'NR>1 && $1==id' | grep -q " $((pos+1)) $name\$" ||
      zellij --session "$HUBNAME" action rename-tab-by-id "$id" "$((pos+1)) $name" >/dev/null 2>&1
  done
}
open_tab() {  # open (or jump to) the hub tab for <session>
  hub_running || return 1
  if hub_tabs | cut -f3 | grep -qx "$1"; then
    zellij --session "$HUBNAME" action go-to-tab-by-id "$(hub_tabs | awk -F'\t' -v n="$1" '$3==n{print $1; exit}')" >/dev/null 2>&1; return 0; fi
  local tmp="$CFG/tab-$1.kdl"; { echo "layout {"; bars; tab_layout "$1" | sed '1s/^  tab [^{]*{/  tab {/'; echo "}"; } > "$tmp"
  zellij --session "$HUBNAME" action new-tab --name "$1" --layout "$tmp" >/dev/null 2>&1; rm -f "$tmp"
  renumber_tabs
}
close_tab() {  # close the hub tab for <session>, if open
  hub_running || return 0
  local id; id="$(hub_tabs | awk -F'\t' -v n="$1" '$3==n{print $1; exit}')"
  [ -n "$id" ] && zellij --session "$HUBNAME" action close-tab-by-id "$id" >/dev/null 2>&1
  renumber_tabs
}
cmd_open_session() {
  local n="$1"; need_session "$n"
  open_tab "$n" && echo "$(c 32)✓$(c 0) '$n' is open in the hub." || { echo "The hub isn't open — starting '$n' in this terminal instead."; cmd_attach "$n"; }
}
ask() {  # ask "Question" default  → reply (or default when not interactive)
  local q="$1" d="$2" r; if [ -t 0 ]; then printf '%s%s: ' "$q" "${d:+ [$d]}" >&2; read -r r; fi; echo "${r:-$d}"; }
cmd_new() {
  local n="" h="" e="" a="" f=""
  while [ $# -gt 0 ]; do case "$1" in
    --on) h="$2"; shift 2;; --engine) e="$2"; shift 2;; --account) a="$2"; shift 2;; --folder) f="$2"; shift 2;;
    *) n="$1"; shift;; esac; done
  echo "$(c 1)New session$(c 0) — a new tab running on one of your machines"
  if [ -z "$h" ]; then echo "Machines: $(hosts | cut -f1 | paste -sd' ' - | sed 's/ /, /g')"; h="$(ask "Machine" "$(self_name)")"; fi
  need_host "$h"
  [ -n "$e" ] || e="$(ask "Engine — claude, opencode (local models) or shell" claude)"
  case "$e" in claude|opencode|shell) ;; *) die "engine must be claude, opencode or shell";; esac
  if [ "$e" = claude ]; then [ -n "$a" ] || a="$(ask "Claude account — default, or a label like work" default)"; else a="-"; fi
  [ -n "$f" ] || f="$(ask "Start folder" "~")"
  [ -n "$n" ] || n="$(ask "Tab name" "$h-$e")"
  [[ "$n" =~ ^[A-Za-z0-9_-]+$ ]] || die "tab name: letters, digits, - and _ only"
  sfield "$n" 1 >/dev/null 2>&1 && die "a session called '$n' already exists"
  printf '%-14s| %-8s| %-9s| %-8s| %s\n' "$n" "$h" "$e" "$a" "$f" >> "$SESSIONS"
  open_tab "$n"
  echo "$(c 32)✓$(c 0) Added '$n' ($e on $h$([ "$e" = claude ] && echo ", account $a"))."
  hub_running && echo "  Its tab is open in the hub." || echo "  Open the hub with: gwm"
  [ "$e" = claude ] && [ "$a" != default ] && echo "  First time with account '$a' on $h? Sign in inside the tab, or: gwm login $a --on $h"
}
cmd_close() {
  local n="" yes=""; for x in "$@"; do case "$x" in -y|--yes) yes=1;; *) n="$x";; esac; done
  [ -n "$n" ] || die "usage: gwm close <session> [--yes]"; need_session "$n"
  local h; h="$(sfield "$n" 2)"
  if [ -z "$yes" ]; then
    [ -t 0 ] || die "add --yes to confirm closing '$n'"
    printf "Close '%s'? This stops whatever is running in it on %s and removes its tab. [y/N] " "$n" "$h"; read -r r
    case "$r" in y|Y|yes) ;; *) echo "Cancelled."; return;; esac
  fi
  run_script "$h" "tmux kill-session -t $PFX$n 2>/dev/null" || true
  awk -F'|' -v n="$n" '{v=$1; gsub(/^[[:space:]]+|[[:space:]]+$/,"",v)} v!=n' "$SESSIONS" > "$SESSIONS.new" && mv "$SESSIONS.new" "$SESSIONS"
  close_tab "$n"
  echo "$(c 32)✓$(c 0) Closed '$n' on $h."
}
cmd_peek() { local n="$1" k="${2:-40}"; need_session "$n"
  run_script "$(sfield "$n" 2)" "tmux capture-pane -p -J -t $PFX$n -S -$k 2>/dev/null | awk 'NF{p=NR} {l[NR]=\$0} END{for(i=1;i<=p;i++) print l[i]}' || echo '(session $n is not running)'"; }
cmd_send() { local n="$1"; shift; need_session "$n"
  run_script "$(sfield "$n" 2)" "printf %s $(b64 "$*") | base64 -d | tmux load-buffer -b gwm - && tmux paste-buffer -d -b gwm -t $PFX$n && sleep 0.3 && tmux send-keys -t $PFX$n Enter && echo 'sent to $n'"; }
cmd_stop() { local n="$1"; need_session "$n"
  run_script "$(sfield "$n" 2)" "tmux kill-session -t $PFX$n 2>/dev/null; echo 'stopped $n — its tab stays; press Enter there to start it fresh'"; }
cmd_who() {  # who is using which machine right now
  local data map; data="$(probe_all)"; map="$(ip_map)"
  while IFS=$'\t' read -r h _; do
    if grep -q "^$h|H|" <<<"$data"; then ub="$(used_by "$h" "$data" "$map")"; printf "%-12s %s\n" "$h" "${ub:-nobody else}"
    else printf "%-12s %s\n" "$h" "offline"; fi
  done < <(hosts)
}

# ---------- hosts ----------
cmd_run() { local h="$1"; shift; need_host "$h"; run_script "$h" "cd ~ && eval \"\$(printf %s $(b64 "$*") | base64 -d)\""; }
cmd_doctor() {
  while IFS=$'\t' read -r h t role; do
    printf "$(c 1)%s$(c 0)  %s\n" "$h" "$(is_local "$h" && echo "(this machine)" || echo "$t")"
    out="$(run_script "$h" 'echo reach-ok; for x in tmux claude opencode ollama limactl; do command -v $x >/dev/null && echo "$x-ok"; done; [ "$(uname)" = Darwin ] && pmset -g | awk "/ sleep /{print \"sleep=\"\$2}"' 2>&1)"
    if ! grep -q reach-ok <<<"$out"; then
      echo "  $(c 31)✗ unreachable:$(c 0) $(tail -1 <<<"$out")"
      case "$t" in vm:*) echo "    → start it: gwm vm start ${t#*/} --on ${t#vm:}" | sed 's#/[^ ]*$##';;
        *) echo "    → on $h: System Settings → General → Sharing → Remote Login ON"
           echo "    → then on $h:  ssh $(hfield "$(self_name)" 2 2>/dev/null) cat .ssh/id_ed25519.pub >> ~/.ssh/authorized_keys";; esac
      continue
    fi
    for x in tmux claude opencode ollama limactl; do
      grep -q "^$x-ok" <<<"$out" && printf "  $(c 32)✓$(c 0) %s" "$x" || printf "  $(c 2)· %s$(c 0)" "$x"; done; echo
    s="$(grep sleep= <<<"$out" | cut -d= -f2)"
    [ -n "$s" ] && { [ "$s" = 0 ] && echo "  $(c 32)✓$(c 0) never sleeps" || echo "  $(c 33)•$(c 0) sleeps after $s min (servers: sudo pmset -a sleep 0)"; }
  done < <(hosts)
}

# ---------- accounts ----------
cmd_accounts() {
  parse_on "$@"
  run_script "$ON" '
show() { s=$(env ${1:+CLAUDE_CONFIG_DIR="$1"} claude auth status 2>/dev/null)
  if echo "$s" | grep -q "\"loggedIn\": true"; then echo "logged in  $(echo "$s" | grep -o "\"email\": *\"[^\"]*\"" | cut -d\" -f4)"; else echo "not logged in"; fi; }
setopt NULL_GLOB 2>/dev/null || true
printf "%-12s %s\n" default "$(show "")"
for d in $HOME/.config/go-with-me/accounts/*/; do [ -d "$d" ] && printf "%-12s %s\n" "$(basename "$d")" "$(show "${d%/}")"; done'
}
cmd_login() {
  local a; parse_on "$@"; a="${ARGS[0]:-}"; [ -n "$a" ] || die "usage: gwm login <account> [--on host]"
  if [ "$a" = default ]; then run_tty "$ON" "claude auth login"
  else run_tty "$ON" "mkdir -p $ACCT_DIR/$a && CLAUDE_CONFIG_DIR=$ACCT_DIR/$a claude auth login"; fi
}

# ---------- VMs ----------
cmd_vm() {
  local sub="${1:-list}"; shift || true; parse_on "$@"; local name="${ARGS[0]:-}"
  run_script "$ON" 'command -v limactl >/dev/null' || die "Lima isn't installed on $ON (run there: brew install lima)"
  case "$sub" in
    list)  run_script "$ON" "limactl list" ;;
    start|stop) [ -n "$name" ] || die "usage: gwm vm $sub <name> [--on host]"; run_script "$ON" "limactl $sub $name" ;;
    delete) [ -n "$name" ] || die "usage: gwm vm delete <name> [--on host]"
      run_script "$ON" "limactl delete --force $name" && {
        sed -i '' "/^$name[[:space:]]*|[[:space:]]*vm:/d" "$HOSTS"; sed -i '' "/^$name[[:space:]]*|[[:space:]]*$name[[:space:]]*|/d" "$SESSIONS"
        echo "Deleted VM $name and removed it from your config."; } ;;
    create)
      [ -n "$name" ] || die "usage: gwm vm create <name> [--on host] [--cpus N] [--memory GB] [--disk GB]"
      local cpus=4 mem=8 disk=60 i=1
      while [ $i -lt ${#ARGS[@]} ]; do case "${ARGS[$i]}" in
        --cpus) cpus="${ARGS[$((i+1))]}";; --memory) mem="${ARGS[$((i+1))]}";; --disk) disk="${ARGS[$((i+1))]}";; esac; i=$((i+2)); done
      echo "Creating Linux VM '$name' on $ON ($cpus CPUs, ${mem}GB RAM, ${disk}GB disk). First time downloads Ubuntu (~600MB)…"
      run_script "$ON" "limactl create --name=$name --cpus=$cpus --memory=$mem --disk=$disk --tty=false template:default && limactl start $name" || die "VM creation failed"
      echo "Installing tmux, git and Claude Code inside the VM…"
      run_script "$ON" "limactl shell --workdir / $name -- bash -lc 'sudo apt-get update -qq && sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq tmux git curl >/dev/null && curl -fsSL https://claude.ai/install.sh | bash'"
      grep -q "^$name[[:space:]]*|" "$HOSTS" || printf '%-12s | vm:%s/%s | Linux VM on %s (%s CPU, %sGB)\n' "$name" "$ON" "$name" "$ON" "$cpus" "$mem" >> "$HOSTS"
      grep -q "^$name[[:space:]]*|" "$SESSIONS" || printf '%-14s | %-10s | claude   | default  | ~\n' "$name" "$name" >> "$SESSIONS"
      echo "Done. Added host + session '$name'. Sign Claude in inside it:  gwm login default --on $name"
      echo "Restart the hub to get its tab:  gwm kill && gwm" ;;
    *) die "usage: gwm vm create|list|start|stop|delete" ;;
  esac
}

# ---------- local models ----------
cmd_models() { parse_on "$@"; run_script "$ON" 'command -v ollama >/dev/null || { echo "Ollama not installed (brew install ollama && brew services start ollama)"; exit; }
echo "INSTALLED"; ollama list; echo; echo "LOADED IN MEMORY"; ollama ps'; }
cmd_pull() { parse_on "$@"; [ -n "${ARGS[0]:-}" ] || die "usage: gwm pull <model> [--on host]"; run_tty "$ON" "ollama pull ${ARGS[0]}"; }
cmd_opencode_setup() {
  parse_on "$@"; local model="" i=0
  while [ $i -lt ${#ARGS[@]} ]; do [ "${ARGS[$i]}" = --model ] && model="${ARGS[$((i+1))]}"; i=$((i+1)); done
  run_script "$ON" "
f=\$HOME/.config/opencode/opencode.json; mkdir -p \$(dirname \$f); [ -f \$f ] && cp \$f \$f.bak
ollama list 2>/dev/null | awk 'NR>1{print \$1}' > /tmp/gwm-models
python3 - \"\$f\" '$model' <<'PY'
import json, sys, os
path, want = sys.argv[1], sys.argv[2]
cfg = json.load(open(path)) if os.path.exists(path) else {}
models = [m.strip() for m in open('/tmp/gwm-models') if m.strip()]
cfg.setdefault('\$schema', 'https://opencode.ai/config.json')
prov = cfg.setdefault('provider', {})
prov.pop('lmstudio', None)
prov['ollama'] = {'npm': '@ai-sdk/openai-compatible', 'name': 'Ollama (local)',
                  'options': {'baseURL': 'http://127.0.0.1:11434/v1'},
                  'models': {m: {'name': m} for m in models}}
pick = want or next((m for m in models if 'inkling' in m), models[0] if models else '')
if pick: cfg['model'] = 'ollama/' + pick
json.dump(cfg, open(path, 'w'), indent=2)
print('opencode → Ollama with', len(models), 'models; default:', pick or '(none installed yet)')
PY"
}

# ---------- setup ----------
HOSTS_HEADER='# go-with-me machines:  name | ssh target | role      (add more with: gwm add)
#   ssh target: user@address — a Tailscale name works from anywhere; a .local name works on the same Wi-Fi.
#   Lima VMs look like vm:<machine>/<vm-name> (gwm vm create adds them).'
SESSIONS_HEADER='# go-with-me sessions (tabs):  name | machine | engine | account | folder
#   engine: claude | opencode | shell     account: default, or any label (gwm login <label> --on <machine>)
#   gwm new / gwm close edit this file for you.'

my_address() {  # best address other machines can use to reach this one
  local ts; ts="$(tailscale status --json 2>/dev/null | python3 -c 'import sys,json; print(json.load(sys.stdin)["Self"]["DNSName"].rstrip("."))' 2>/dev/null)"
  if [ -n "$ts" ]; then echo "$ts"; else echo "$(scutil --get LocalHostName 2>/dev/null || hostname -s).local"; fi
}
ensure_key() {  # make sure this machine has an SSH key; print the public key
  [ -f "$HOME/.ssh/id_ed25519.pub" ] || { mkdir -p "$HOME/.ssh" && chmod 700 "$HOME/.ssh" &&
    ssh-keygen -q -t ed25519 -N "" -C "go-with-me@$(self_name)" -f "$HOME/.ssh/id_ed25519"; }
  cat "$HOME/.ssh/id_ed25519.pub"
}
upsert_host() {  # upsert_host name target role
  awk -F'|' -v n="$1" '{v=$1; gsub(/^[[:space:]]+|[[:space:]]+$/,"",v)} v!=n' "$HOSTS" > "$HOSTS.new"
  printf '%-10s| %-40s| %s\n' "$1" "$2" "$3" >> "$HOSTS.new"; mv "$HOSTS.new" "$HOSTS"
}
cmd_init() {
  local n="${1:-}"
  [ -n "$n" ] || n="$(ask "Name for this machine (short, e.g. studio, macbook)" "$(scutil --get LocalHostName 2>/dev/null | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9-]//g' | cut -c1-20)")"
  [[ "$n" =~ ^[A-Za-z0-9_-]+$ ]] || die "name: letters, digits, - and _ only"
  mkdir -p "$CFG/accounts"
  [ -f "$HOSTS" ]    || printf '%s\n\n' "$HOSTS_HEADER" > "$HOSTS"
  [ -f "$SESSIONS" ] || printf '%s\n\n' "$SESSIONS_HEADER" > "$SESSIONS"
  echo "$n" > "$SELF_FILE"
  if ! hfield "$n" 1 >/dev/null 2>&1; then
    local ram; ram="$(( $(sysctl -n hw.memsize 2>/dev/null || echo 0) / 1073741824 ))"
    upsert_host "$n" "$(whoami)@$(my_address)" "$(sysctl -n hw.model 2>/dev/null || uname -s), ${ram}GB"
  fi
  sfield "$n" 1 >/dev/null 2>&1 || printf '%-14s| %-8s| %-9s| %-8s| %s\n' "$n" "$n" claude default "~" >> "$SESSIONS"
  ensure_key >/dev/null
  echo "$(c 32)✓$(c 0) This machine is '$n' ($(whoami)@$(my_address)). Config: $CFG"
  echo "  Next: add your other machines with  $(c 1)gwm add$(c 0)   ·   then open the hub with  $(c 1)gwm$(c 0)"
}

# ---------- Tailscale ----------
ts_running() { tailscale status --json 2>/dev/null | grep -q '"BackendState": *"Running"'; }
ts_ssh_on()  { tailscale debug prefs 2>/dev/null | grep -q '"RunSSH": *true'; }
cmd_tailscale() {  # set up Tailscale + Tailscale SSH on this Mac, so other machines can reach it without Remote Login
  echo "$(c 1)Tailscale for go-with-me$(c 0) — lets your machines reach each other from anywhere, no Remote Login needed."
  if [ -d /Applications/Tailscale.app ] && ! command -v tailscaled >/dev/null; then
    echo "$(c 33)•$(c 0) You have the Tailscale app. On a Mac, only the open-source command-line Tailscale can accept SSH logins,"
    echo "  so go-with-me uses that one. Quit the Tailscale app (menu bar → Quit) before continuing; you can keep it for other things."
    [ "$(ask "Continue? (y/n)" y)" = y ] || exit 0
  fi
  command -v tailscaled >/dev/null || { echo "Installing Tailscale (open-source)…"; brew install tailscale >/dev/null || die "brew install tailscale failed"; }
  if ! tailscale status >/dev/null 2>&1 && ! tailscale status 2>&1 | grep -qi 'logged out\|NeedsLogin'; then
    echo "Starting the Tailscale service — enter $(c 1)your Mac password$(c 0) if asked:"
    sudo brew services start tailscale >/dev/null || die "couldn't start Tailscale"; sleep 3
  fi
  if ts_running; then
    ts_ssh_on || { echo "Turning on Tailscale SSH…"; sudo tailscale set --ssh || die "couldn't turn on Tailscale SSH"; }
  else
    echo "Sign in — a link opens below. Use the $(c 1)same Tailscale account$(c 0) on every machine:"
    sudo tailscale up --ssh || die "Tailscale sign-in didn't finish"
  fi
  ts_running || die "Tailscale isn't connected yet — run gwm tailscale again"
  local addr; addr="$(my_address)"
  echo "$(c 32)✓$(c 0) Tailscale is on, with Tailscale SSH. This Mac is reachable as $(c 1)$(whoami)@$addr$(c 0) from anywhere."
  local me; me="$(self_name)"
  if [ -n "$me" ] && [ -f "$HOSTS" ] && [ "$(hfield "$me" 2 2>/dev/null)" != "$(whoami)@$addr" ]; then
    upsert_host "$me" "$(whoami)@$addr" "$(hfield "$me" 3 2>/dev/null || echo "this machine")"
    echo "$(c 32)✓$(c 0) Updated '$me' in your config to its Tailscale address"
  fi
  echo
  echo "One-time, in your Tailscale admin console: make SSH between your own devices not ask for a browser login every 12h."
  echo "  https://login.tailscale.com/admin/acls  →  in the \"ssh\" section set  $(c 1)\"action\": \"accept\"$(c 0)  (see docs/SETUP.md)"
  echo "Then add machines with:  $(c 1)gwm add$(c 0)"
}

# ---------- adding machines ----------
discover() {  # print "address<TAB>description" for machines we can see: Tailscale peers + Macs on this Wi-Fi with Remote Login on
  tailscale status --json 2>/dev/null | python3 -c '
import sys, json
d = json.load(sys.stdin)
for p in (d.get("Peer") or {}).values():
    name = p.get("DNSName", "").rstrip(".")
    if name: print(f"{name}\tTailscale · {p.get(\"OS\",\"?\")} · {\"online\" if p.get(\"Online\") else \"offline\"}")' 2>/dev/null
  local mine; mine="$(scutil --get LocalHostName 2>/dev/null)"
  perl -e 'alarm 3; exec @ARGV' dns-sd -B _ssh._tcp local. 2>/dev/null | awk 'NR>4 && $2=="Add" {$1=$2=$3=$4=$5=$6=""; sub(/^ +/,""); print}' | sort -u |
  while IFS= read -r inst; do
    ( perl -e 'alarm 3; exec @ARGV' dns-sd -L "$inst" _ssh._tcp local. 2>/dev/null | grep -o 'reached at [^ ]*' | head -1 |
        awk -v i="$inst" '{h=$3; sub(/:[0-9]+$/,"",h); sub(/\.$/,"",h); printf "%s\tsame Wi-Fi · %s\n", h, i}' ) &
  done | grep -v "^$mine\.local" ; wait
}
cmd_add() {
  local n="" addr="" user="" role="" yes="" via=""
  while [ $# -gt 0 ]; do case "$1" in
    --address) addr="$2"; shift 2;; --user) user="$2"; shift 2;; --role) role="$2"; shift 2;; -y|--yes) yes=1; shift;;
    --via) via="$2"; shift 2;;
    *) n="$1"; shift;; esac; done
  [ -n "$(self_name)" ] || die "run 'gwm init' on this machine first"
  local me mytarget; me="$(self_name)"; mytarget="$(hfield "$me" 2)"
  echo "$(c 1)Add a machine to go-with-me$(c 0)"

  # 0. how do we connect? Tailscale SSH (no Remote Login, works anywhere) or Remote Login (plain SSH)
  case "$via" in tailscale|ts) via=tailscale;; ssh|remote-login) via=ssh;; "") ;; *) die "--via must be tailscale or ssh";; esac
  if [ -z "$via" ] && [ -n "$addr" ]; then
    case "$addr" in *.ts.net|100.*) via=tailscale;; *) via=ssh;; esac
  fi
  if [ -z "$via" ]; then
    echo "How should go-with-me connect to it?"
    echo "  1) $(c 1)Tailscale$(c 0)     no Remote Login, no keys, works from anywhere  $(c 2)(recommended)$(c 0)"
    echo "  2) $(c 1)Remote Login$(c 0)  plain SSH — same Wi-Fi, or any address you can already SSH to"
    case "$(ask "Choose" 1)" in 2|ssh|r*) via=ssh;; *) via=tailscale;; esac
  fi
  if [ "$via" = tailscale ] && ! ts_running; then
    echo "$(c 33)•$(c 0) Tailscale isn't running on this Mac yet. Set it up with:  $(c 1)gwm tailscale$(c 0)   (then run gwm add again)"
    echo "  Or use Remote Login instead:  gwm add --via ssh"; exit 1
  fi

  # 1. where is it?
  if [ -z "$addr" ]; then
    echo "Looking for machines…"
    local found; found="$(discover | if [ "$via" = tailscale ]; then grep -F 'Tailscale'; else cat; fi)"
    if [ -n "$found" ]; then
      printf '%s\n' "$found" | awk -F'\t' '{printf "  %d) %-40s %s\n", NR, $1, $2}'
      local pick; pick="$(ask "Pick a number, or type an address" 1)"
      if [[ "$pick" =~ ^[0-9]+$ ]]; then addr="$(printf '%s\n' "$found" | sed -n "${pick}p" | cut -f1)"; else addr="$pick"; fi
    else
      [ "$via" = tailscale ] && echo "  (no other Tailscale machines found — sign the other Mac in to the same Tailscale account, or type its name)" \
                             || echo "  (nothing found — type its .local name or IP)"
      addr="$(ask "Address" "")"
    fi
  fi
  [ -n "$addr" ] || die "no address given"
  addr="${addr#*@}"

  # 2. can we reach it at all?
  if ! nc -z -G 4 "$addr" 22 >/dev/null 2>&1; then
    echo "$(c 31)✗$(c 0) $addr isn't accepting SSH connections."
    if [ "$via" = tailscale ]; then
      echo "  On that Mac, run $(c 1)gwm tailscale$(c 0) (or: sudo tailscale set --ssh) to turn on Tailscale SSH, then run gwm add again."
    else
      echo "  On that Mac: System Settings → General → Sharing → turn on $(c 1)Remote Login$(c 0), then run gwm add again."
      echo "  (Away from home? Use Tailscale instead: gwm add --via tailscale)"
    fi; exit 1
  fi
  echo "$(c 32)✓$(c 0) $addr is reachable ($([ "$via" = tailscale ] && echo "Tailscale SSH" || echo "Remote Login"))"

  # 3. which user?
  [ -n "$user" ] || { [ -n "$yes" ] && user="$(whoami)"; } || true
  [ -n "$user" ] || user="$(ask "Your username on that Mac (run 'whoami' there if unsure)" "$(whoami)")"
  local t="$user@$addr"
  local sshq=(ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ConnectTimeout=6 -o LogLevel=ERROR)

  # 4. log in. Tailscale SSH: no keys — Tailscale vouches for you. Remote Login: copy this Mac's key once.
  if [ "$via" = tailscale ]; then
    if ! "${sshq[@]}" "$t" true 2>/dev/null; then
      echo "$(c 31)✗$(c 0) Tailscale SSH refused the login as '$user'. Usually one of:"
      echo "  • your tailnet's SSH rule is in \"check\" mode (asks for a browser login every 12h) — switch it to \"accept\":"
      echo "    https://login.tailscale.com/admin/acls → in \"ssh\", set \"action\": \"accept\"   (details: docs/SETUP.md)"
      echo "  • wrong username — run 'whoami' on that Mac and try: gwm add --via tailscale --user <name> --address $addr"; exit 1
    fi
  else
  ensure_key >/dev/null
  if ! "${sshq[@]}" "$t" true 2>/dev/null; then
    echo "This Mac's key isn't trusted there yet. Copying it now — enter $(c 1)$user's password on $addr$(c 0) once:"
    ssh-copy-id -o StrictHostKeyChecking=accept-new -i "$HOME/.ssh/id_ed25519.pub" "$t" >/dev/null 2>&1 </dev/tty || true
    if ! "${sshq[@]}" "$t" true 2>/dev/null; then
      echo "$(c 31)✗$(c 0) Still can't log in as '$user'. Common causes:"
      echo "  • wrong username — run 'whoami' on that Mac and try: gwm add --user <name> --address $addr"
      echo "  • Remote Login limited to some users — Sharing → Remote Login → ⓘ → Allow access for: All users"; exit 1
    fi
  fi
  fi
  echo "$(c 32)✓$(c 0) Logged in as $user"

  # 5. what is it?
  local info; info="$(run_script_target "$t" 'echo "host=$(scutil --get LocalHostName 2>/dev/null || hostname -s)"; echo "os=$(sw_vers -productVersion 2>/dev/null || uname -sr)"
    echo "ram=$(( $(sysctl -n hw.memsize 2>/dev/null || echo 0) / 1073741824 ))"; echo "model=$(sysctl -n hw.model 2>/dev/null || uname -m)"
    for x in brew tmux zellij claude opencode ollama limactl tailscale; do command -v $x >/dev/null && echo "has=$x"; done')"
  local rhost ros rram rmodel; rhost="$(sed -n 's/^host=//p' <<<"$info")"; ros="$(sed -n 's/^os=//p' <<<"$info")"
  rram="$(sed -n 's/^ram=//p' <<<"$info")"; rmodel="$(sed -n 's/^model=//p' <<<"$info")"
  has() { grep -qx "has=$1" <<<"$info"; }
  printf "$(c 32)✓$(c 0) %s · %s · %sGB · " "$rhost" "$ros" "$rram"
  for x in tmux claude opencode ollama; do has $x && printf "%s ✓ " "$x" || printf "$(c 2)%s ✗$(c 0) " "$x"; done; echo
  if ! has tmux; then
    if has brew && { [ -n "$yes" ] || [ "$(ask "tmux is needed to keep sessions running there. Install it now? (y/n)" y)" = y ]; }; then
      run_script_target "$t" 'brew install tmux >/dev/null 2>&1 && echo ok' | grep -q ok && echo "$(c 32)✓$(c 0) installed tmux" || echo "$(c 33)•$(c 0) couldn't install tmux — run 'brew install tmux' there"
    else echo "$(c 33)•$(c 0) install tmux there (brew install tmux) before opening sessions on it"; fi
  fi

  # 6. name + save
  [ -n "$n" ] || n="$(ask "Short name for it" "$(echo "$rhost" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9-]//g' | sed 's/^.*s-//' | cut -c1-20)")"
  [[ "$n" =~ ^[A-Za-z0-9_-]+$ ]] || die "name: letters, digits, - and _ only"
  [ "$n" = "$me" ] && die "'$n' is this machine's name — pick another"
  [ -n "$role" ] || role="$rmodel, ${rram}GB"
  upsert_host "$n" "$t" "$role"
  echo "$(c 32)✓$(c 0) Saved as '$n' → $t"

  # 7. the other direction: it → this machine (for gwm on that machine, and its board)
  local rkey=""
  if [ "$via" = tailscale ]; then
    case "$mytarget" in *.ts.net|*@100.*) ;; *) echo "$(c 33)•$(c 0) This Mac is saved as $mytarget — run $(c 1)gwm tailscale$(c 0) here so '$n' can reach it over Tailscale too";; esac
    run_script_target "$t" "ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ConnectTimeout=6 -o LogLevel=ERROR $mytarget true && echo back-ok" 2>/dev/null | grep -q back-ok &&
      echo "$(c 32)✓$(c 0) '$n' can reach this Mac too" || echo "$(c 33)•$(c 0) '$n' can't reach this Mac yet — run gwm tailscale here (it turns on Tailscale SSH)"
  else
    rkey="$(run_script_target "$t" '[ -f ~/.ssh/id_ed25519.pub ] || ssh-keygen -q -t ed25519 -N "" -C "go-with-me@'"$n"'" -f ~/.ssh/id_ed25519; cat ~/.ssh/id_ed25519.pub')"
  fi
  if [ -n "$rkey" ]; then
    mkdir -p "$HOME/.ssh"; touch "$HOME/.ssh/authorized_keys"; chmod 600 "$HOME/.ssh/authorized_keys"
    grep -qF "$rkey" "$HOME/.ssh/authorized_keys" || echo "$rkey" >> "$HOME/.ssh/authorized_keys"
    if run_script_target "$t" "ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ConnectTimeout=6 -o LogLevel=ERROR $mytarget true && echo back-ok" 2>/dev/null | grep -q back-ok; then
      echo "$(c 32)✓$(c 0) '$n' can reach this Mac too"
    else
      echo "$(c 33)•$(c 0) '$n' can't reach this Mac yet — turn on Remote Login here (System Settings → General → Sharing)"
    fi
  fi

  # 8. install go-with-me there with the same config
  if [ -n "$yes" ] || [ "$(ask "Install go-with-me on '$n' too, so you can open the hub from there? (y/n)" y)" = y ]; then
    rsync -a --delete --exclude .DS_Store -e "ssh -o BatchMode=yes -o LogLevel=ERROR" "$DIR/" "$t:go-with-me/" &&
    run_script_target "$t" "mkdir -p ~/.config/go-with-me/accounts" &&
    scp -q -o BatchMode=yes "$HOSTS" "$SESSIONS" "$t:.config/go-with-me/" &&
    run_script_target "$t" "~/go-with-me/install.sh >/dev/null && echo $n > ~/.config/go-with-me/self && echo ok" | grep -q ok &&
      echo "$(c 32)✓$(c 0) go-with-me installed on '$n' (run gwm there)" || echo "$(c 33)•$(c 0) couldn't install go-with-me there — see docs/SETUP.md"
    # keep every other machine's copy of the config in sync
    while IFS=$'\t' read -r h ht _; do
      [ "$h" = "$me" ] || [ "$h" = "$n" ] && continue; case "$ht" in vm:*) continue;; esac
      scp -q -o BatchMode=yes -o ConnectTimeout=4 "$HOSTS" "$SESSIONS" "$ht:.config/go-with-me/" 2>/dev/null
    done < <(hosts)
  fi

  # 9. a tab for it
  if ! sessions | awk -F'\t' -v h="$n" '$2==h{f=1} END{exit !f}'; then
    if [ -n "$yes" ] || [ "$(ask "Add a Claude Code tab on '$n'? (y/n)" y)" = y ]; then
      printf '%-14s| %-8s| %-9s| %-8s| %s\n' "$n" "$n" claude default "~" >> "$SESSIONS"; echo "$(c 32)✓$(c 0) Added session '$n'"
    fi
  fi
  echo; echo "Done — '$n' is on your board.  gwm status  ·  gwm  ·  gwm open $n"
}
run_script_target() {  # like run_script, but for a raw user@address that isn't saved yet
  printf '%s\n%s\n' "$PATHFIX" "$2" | ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ConnectTimeout=6 -o LogLevel=ERROR "$1" 'exec "$SHELL" -l -s'
}
cmd_remove() {
  local n="${1:-}"; [ -n "$n" ] || die "usage: gwm remove <machine>"; need_host "$n"
  [ "$n" = "$(self_name)" ] && die "can't remove this machine"
  awk -F'|' -v n="$n" '{v=$1; gsub(/^[[:space:]]+|[[:space:]]+$/,"",v)} v!=n' "$HOSTS" > "$HOSTS.new" && mv "$HOSTS.new" "$HOSTS"
  awk -F'|' -v n="$n" '{v=$2; gsub(/^[[:space:]]+|[[:space:]]+$/,"",v)} v!=n' "$SESSIONS" > "$SESSIONS.new" && mv "$SESSIONS.new" "$SESSIONS"
  echo "$(c 32)✓$(c 0) Removed '$n' and its sessions from this machine's config (nothing on '$n' was changed)."
}
cmd_sync() { local h="$1"; need_host "$h"
  for f in hosts.conf sessions.conf; do run_script "$h" "cat ~/.config/go-with-me/$f" > "$CFG/$f.new" && mv "$CFG/$f.new" "$CFG/$f"; done
  echo "Copied hosts + sessions config from $h."; }

case "${1:-open}" in
  open) if [ $# -ge 2 ]; then cmd_open_session "$2"; else cmd_open; fi ;;  board) cmd_board ;;  status) print_table ;;
  kill) zellij kill-session "$HUBNAME" >/dev/null 2>&1; zellij delete-session "$HUBNAME" >/dev/null 2>&1; echo "Hub closed. Sessions keep running on their machines." ;;
  who) cmd_who ;;
  new) shift; cmd_new "$@" ;;
  close) shift; cmd_close "$@" ;;
  stop|restart) [ $# -ge 2 ] || die "usage: gwm stop <session>"; cmd_stop "$2" ;;
  sessions) sessions | awk -F'\t' 'BEGIN{printf "%-14s %-10s %-9s %-10s %s\n","SESSION","HOST","ENGINE","ACCOUNT","FOLDER"} {printf "%-14s %-10s %-9s %-10s %s\n",$1,$2,$3,$4,$5}' ;;
  hosts) hosts | awk -F'\t' '{printf "%-12s %-28s %s\n",$1,$2,$3}' ;;
  attach)  [ $# -ge 2 ] || die "usage: gwm attach <session>"; cmd_attach "$2" ;;
  peek)    [ $# -ge 2 ] || die "usage: gwm peek <session> [lines]"; cmd_peek "$2" "${3:-40}" ;;
  send)    [ $# -ge 3 ] || die "usage: gwm send <session> <text>"; shift; cmd_send "$@" ;;
  run)     [ $# -ge 3 ] || die "usage: gwm run <host> <command>"; shift; cmd_run "$@" ;;
  doctor) cmd_doctor ;;
  accounts) shift; cmd_accounts "$@" ;;  login) shift; cmd_login "$@" ;;
  vm) shift; cmd_vm "$@" ;;
  models) shift; cmd_models "$@" ;;  pull) shift; cmd_pull "$@" ;;  opencode-setup) shift; cmd_opencode_setup "$@" ;;
  discover) discover ;;
  _data) cmd_data ;;
  sidebar) exec python3 "$DIR/sidebar.py" "$ME" ;;
  tailscale) cmd_tailscale ;;
  init) cmd_init "${2:-}" ;;  add) shift; cmd_add "$@" ;;  remove) [ $# -ge 2 ] || die "usage: gwm remove <machine>"; cmd_remove "$2" ;;  sync) [ $# -ge 2 ] || die "usage: gwm sync <host>"; cmd_sync "$2" ;;
  edit) ${EDITOR:-nano} "$HOSTS" "$SESSIONS" ;;
  -h|--help|help) awk 'NR>1 && /^#/{sub(/^# ?/,""); print; next} NR>1{exit}' "$ME" ;;
  *) die "unknown command '$1' (gwm help)" ;;
esac
