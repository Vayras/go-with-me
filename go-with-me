# ---------- setup ----------
HOSTS_HEADER='# go-with-me machines:  name | ssh target | role      (add more with: gwm add)
#   ssh target: user@address — a Tailscale name works from anywhere; a .local name works on the same Wi-Fi.
#   Lima VMs look like vm:<machine>/<vm-name> (gwm vm create adds them).'
SESSIONS_HEADER='# go-with-me sessions (tabs):  name | machine | engine | account | folder
#   engine: claude | opencode | shell     account: default, or any label (gwm login <label> --on <machine>)
#   gwm new / gwm close edit this file for you.'

my_address() {  # best address other machines can use to reach this one
  local ts; ts="$(tailscale status --json 2>/dev/null | python3 -c 'import sys,json; print(json.load(sys.stdin)["Self"]["DNSName"].rstrip("."))' 2>/dev/null)"
  if [ -n "$ts" ]; then echo "$ts"; else echo "$(scutil --get LocalHostName 2>/dev/null || hostname -s).local"; fi
}
ensure_key() {  # make sure this machine has an SSH key; print the public key
  [ -f "$HOME/.ssh/id_ed25519.pub" ] || { mkdir -p "$HOME/.ssh" && chmod 700 "$HOME/.ssh" &&
    ssh-keygen -q -t ed25519 -N "" -C "go-with-me@$(self_name)" -f "$HOME/.ssh/id_ed25519"; }
  cat "$HOME/.ssh/id_ed25519.pub"
}
upsert_host() {  # upsert_host name target role
  awk -F'|' -v n="$1" '{v=$1; gsub(/^[[:space:]]+|[[:space:]]+$/,"",v)} v!=n' "$HOSTS" > "$HOSTS.new"
  printf '%-10s| %-40s| %s\n' "$1" "$2" "$3" >> "$HOSTS.new"; mv "$HOSTS.new" "$HOSTS"
}
cmd_init() {
  local n="${1:-}"
  [ -n "$n" ] || n="$(ask "Name for this machine (short, e.g. studio, macbook)" "$(scutil --get LocalHostName 2>/dev/null | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9-]//g' | cut -c1-20)")"
  [[ "$n" =~ ^[A-Za-z0-9_-]+$ ]] || die "name: letters, digits, - and _ only"
  mkdir -p "$CFG/accounts"
  [ -f "$HOSTS" ]    || printf '%s\n\n' "$HOSTS_HEADER" > "$HOSTS"
  [ -f "$SESSIONS" ] || printf '%s\n\n' "$SESSIONS_HEADER" > "$SESSIONS"
  echo "$n" > "$SELF_FILE"
  if ! hfield "$n" 1 >/dev/null 2>&1; then
    local ram; ram="$(( $(sysctl -n hw.memsize 2>/dev/null || echo 0) / 1073741824 ))"
    upsert_host "$n" "$(whoami)@$(my_address)" "$(sysctl -n hw.model 2>/dev/null || uname -s), ${ram}GB"
  fi
  ensure_key >/dev/null
  echo "$(c 32)✓$(c 0) This machine is '$n' ($(whoami)@$(my_address)). Config: $CFG"
  echo "  Next: add your other machines with  $(c 1)gwm add$(c 0)   ·   start a session with  $(c 1)gwm new$(c 0)   ·   open the hub with  $(c 1)gwm$(c 0)"
}

# ---------- Tailscale ----------
ts_running() { tailscale status --json 2>/dev/null | grep -q '"BackendState": *"Running"'; }
ts_ssh_on()  { tailscale debug prefs 2>/dev/null | grep -q '"RunSSH": *true'; }
cmd_tailscale() {  # set up Tailscale + Tailscale SSH on this Mac, so other machines can reach it without Remote Login
  echo "$(c 1)Tailscale for go-with-me$(c 0) — lets your machines reach each other from anywhere, no Remote Login needed."
  if [ -d /Applications/Tailscale.app ] && ! command -v tailscaled >/dev/null; then
    echo "$(c 33)•$(c 0) You have the Tailscale app. On a Mac, only the open-source command-line Tailscale can accept SSH logins,"
    echo "  so go-with-me uses that one. Quit the Tailscale app (menu bar → Quit) before continuing; you can keep it for other things."
    [ "$(ask "Continue? (y/n)" y)" = y ] || exit 0
  fi
  command -v tailscaled >/dev/null || { echo "Installing Tailscale (open-source)…"; brew install tailscale >/dev/null || die "brew install tailscale failed"; }
  if ! tailscale status >/dev/null 2>&1 && ! tailscale status 2>&1 | grep -qi 'logged out\|NeedsLogin'; then
    echo "Starting the Tailscale service — enter $(c 1)your Mac password$(c 0) if asked:"
    sudo brew services start tailscale >/dev/null || die "couldn't start Tailscale"; sleep 3
  fi
  if ts_running; then
    ts_ssh_on || { echo "Turning on Tailscale SSH…"; sudo tailscale set --ssh || die "couldn't turn on Tailscale SSH"; }
  else
    echo "Sign in — a link opens below. Use the $(c 1)same Tailscale account$(c 0) on every machine:"
    sudo tailscale up --ssh || die "Tailscale sign-in didn't finish"
  fi
  ts_running || die "Tailscale isn't connected yet — run gwm tailscale again"
  local addr; addr="$(my_address)"
  echo "$(c 32)✓$(c 0) Tailscale is on, with Tailscale SSH. This Mac is reachable as $(c 1)$(whoami)@$addr$(c 0) from anywhere."
  local me; me="$(self_name)"
  if [ -n "$me" ] && [ -f "$HOSTS" ] && [ "$(hfield "$me" 2 2>/dev/null)" != "$(whoami)@$addr" ]; then
    upsert_host "$me" "$(whoami)@$addr" "$(hfield "$me" 3 2>/dev/null || echo "this machine")"
    echo "$(c 32)✓$(c 0) Updated '$me' in your config to its Tailscale address"
  fi
  echo
  echo "One-time, in your Tailscale admin console: make SSH between your own devices not ask for a browser login every 12h."
  echo "  https://login.tailscale.com/admin/acls  →  in the \"ssh\" section set  $(c 1)\"action\": \"accept\"$(c 0)  (see docs/SETUP.md)"
  echo "Then add machines with:  $(c 1)gwm add$(c 0)"
}

