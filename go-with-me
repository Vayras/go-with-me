    */*) run_tty "$ON" "py=/opt/homebrew/opt/omlx/libexec/bin/python; [ -x \$py ] || { echo 'oMLX not installed'; exit 1; }
\$py -c 'import sys, os; from huggingface_hub import snapshot_download; print(snapshot_download(sys.argv[1], local_dir=os.path.expanduser(\"~/.omlx/models/\") + sys.argv[1].split(\"/\")[-1]))' '$m'" ;;
    *) run_tty "$ON" "ollama pull '$m'" ;;
