cmd_pull() { parse_on "$@"; local m="${ARGS[0]:-}"; [ -n "$m" ] || die "usage: gwm pull <model> [--on host]"
  [[ "$m" =~ $MODEL_RE ]] || die "invalid model name '$m'"
