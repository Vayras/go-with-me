cmd_models() { parse_on "$@"; run_script "$ON" 'k=$(cat ~/.omlx/api_key 2>/dev/null); A=(); [ -n "$k" ] && A=(-H "Authorization: Bearer $k")
if curl -sf -m 2 ${A[@]+"${A[@]}"} http://127.0.0.1:8000/v1/models/status >/dev/null; then
  echo "oMLX (http://127.0.0.1:8000, dashboard /admin)"; curl -sf ${A[@]+"${A[@]}"} http://127.0.0.1:8000/v1/models/status | python3 -c "import json, sys
for m in json.load(sys.stdin).get(\"models\", []):
    gb = (m.get(\"actual_size\") or m.get(\"estimated_size\") or 0) / 1e9
    print(\"  %-28s %5.1f GB  %s\" % (m[\"id\"], gb, \"loaded\" if m.get(\"loaded\") else \"\"))"
