# ---------- web access (gwm web) ----------
# Security model:
#   1. Zellij's web server listens on 127.0.0.1 only — nothing on your Wi-Fi or the internet can reach it.
#   2. Tailscale Serve publishes it over HTTPS (real *.ts.net certificate) to devices on YOUR tailnet only
#      (Serve, not Funnel — never public).
#   3. Every browser must log in with a Zellij token. Tokens can be read-only and are revocable; revoking
#      a token cuts off browsers already logged in with it.
WEB_PORT=8082        # local, loopback only
WEB_HTTPS_PORT=8443  # on your tailnet
web_url() { local d; d="$(tailscale status --json 2>/dev/null | python3 -c 'import sys,json; print(json.load(sys.stdin)["Self"]["DNSName"].rstrip("."))' 2>/dev/null)"; echo "https://$d:$WEB_HTTPS_PORT/$HUBNAME"; }
web_online() { zellij --config "$DIR/hub.zellij.kdl" web --status --timeout 3 2>/dev/null | grep -qi online; }
serve_on()   { tailscale serve status 2>/dev/null | grep -q "127.0.0.1:$WEB_PORT"; }
ts_serve() {  # run `tailscale serve ...`; use sudo only if Tailscale says this user isn't allowed to
  local err; err="$(tailscale serve "$@" 2>&1 >/dev/null)" && return 0
  if grep -qiE 'access denied|permission|operator|not permitted' <<<"$err"; then
    echo "Tailscale needs admin rights to publish this — enter $(c 1)your Mac password$(c 0) if asked"
    echo "$(c 2)  (to skip this in future: sudo tailscale set --operator=$USER)$(c 0)"
    sudo tailscale serve "$@"
  else echo "$err" >&2; return 1; fi
}
cmd_web() {
  local sub="${1:-start}"; shift || true
  case "$sub" in
  start)
    command -v zellij >/dev/null || die "zellij not installed (brew install zellij)"
    ts_running || die "Tailscale isn't running on this Mac — run: gwm tailscale"
    [ -n "$(self_name)" ] || die "run 'gwm init' first"
    for v in $(env | sed -n 's/^\(CLAUDECODE\|CLAUDE_CODE_[A-Z_]*\)=.*/\1/p'); do unset "$v"; done
    unset TERM_SESSION_ID SHELL_SESSION_ID
    # 1. the hub (started in the background if it isn't running; nothing inside it is auto-launched)
    if ! hub_running; then
      zellij delete-session "$HUBNAME" >/dev/null 2>&1; write_layout
      zellij --config "$DIR/hub.zellij.kdl" --layout "$CFG/hub-layout.kdl" attach --create-background "$HUBNAME" >/dev/null 2>&1 \
        || die "couldn't start the hub in the background"
      echo "$(c 32)✓$(c 0) hub started in the background"
    else
      echo "$(c 32)✓$(c 0) hub is running $(c 2)(if it was opened before you updated go-with-me, run gwm kill once so it can be shared)$(c 0)"
    fi
    # 2. the local web server — loopback only
    if ! web_online; then
      zellij --config "$DIR/hub.zellij.kdl" web --daemonize >/dev/null 2>&1 || die "couldn't start the web server"
      sleep 1
    fi
    local binds; binds="$(lsof -nP -iTCP:$WEB_PORT -sTCP:LISTEN 2>/dev/null | awk 'NR>1{print $9}')"
    if [ -z "$binds" ]; then
      zellij --config "$DIR/hub.zellij.kdl" web --stop >/dev/null 2>&1; die "the web server didn't come up on 127.0.0.1:$WEB_PORT"
    fi
    if grep -vqE '^(127\.0\.0\.1|\[::1\]):' <<<"$binds"; then
      zellij --config "$DIR/hub.zellij.kdl" web --stop >/dev/null 2>&1
      die "the web server was listening beyond this Mac ($binds) — stopped it (check web_server_ip in hub.zellij.kdl)"
    fi
    echo "$(c 32)✓$(c 0) web server on 127.0.0.1:$WEB_PORT (this Mac only)"
    # 3. publish to the tailnet over HTTPS (Serve settings persist across reboots, so they're re-checked every start)
    if ! tailscale status --json 2>/dev/null | python3 -c 'import sys,json; sys.exit(0 if json.load(sys.stdin).get("CertDomains") else 1)'; then
      echo "$(c 33)•$(c 0) Your tailnet doesn't have HTTPS certificates turned on yet (needed so browsers get a real https:// link)."
      echo "  Turn on $(c 1)HTTPS Certificates$(c 0) at https://login.tailscale.com/admin/dns , then run: gwm web"; exit 1
    fi
    if ! serve_on; then
      ts_serve --bg --https=$WEB_HTTPS_PORT "http://127.0.0.1:$WEB_PORT" || die "couldn't publish with Tailscale Serve"
    fi
    echo "$(c 32)✓$(c 0) published to your tailnet only over HTTPS (Tailscale Serve, not Funnel)"
    # 4. a login token, the first time
    if ! zellij web --list-tokens 2>/dev/null | grep -q .; then
      echo; echo "$(c 1)Your login token$(c 0) — shown once. Save it in your password manager:"
      zellij web --create-token 2>/dev/null | grep -iE '^[a-z0-9_]+: ' | sed 's/^/  /'
      echo "  (more tokens: gwm web token · read-only: gwm web token --read-only · revoke: gwm web revoke <name>)"
    fi
    echo; echo "Open on any of your Tailscale devices:  $(c 1)$(web_url)$(c 0)"
    echo "$(c 2)Anyone with a token gets a terminal on this Mac — treat tokens like passwords. Stop sharing: gwm web stop$(c 0)" ;;
  stop)
    tailscale serve --https=$WEB_HTTPS_PORT off >/dev/null 2>&1 || { serve_on && sudo tailscale serve --https=$WEB_HTTPS_PORT off >/dev/null 2>&1; } || true
    zellij --config "$DIR/hub.zellij.kdl" web --stop >/dev/null 2>&1
    echo "$(c 32)✓$(c 0) Web access stopped (nothing published, server off). Your hub and sessions keep running." ;;
  status)
    web_online && echo "web server   $(c 32)on$(c 0)  127.0.0.1:$WEB_PORT" || echo "web server   off"
    serve_on && echo "tailnet      $(c 32)published$(c 0)  $(web_url)" || echo "tailnet      not published"
    echo "tokens:"; zellij web --list-tokens 2>/dev/null | sed 's/^/  /' | grep . || echo "  (none)" ;;
  token)
    local ro=""; [ "${1:-}" = "--read-only" ] && ro=1
    echo "New $( [ -n "$ro" ] && echo "read-only " )login token — shown once:"
    if [ -n "$ro" ]; then zellij web --create-read-only-token 2>/dev/null; else zellij web --create-token 2>/dev/null; fi | grep -iE '^[a-z0-9_]+: ' | sed 's/^/  /' ;;
  tokens) zellij web --list-tokens 2>/dev/null | grep . || echo "(no tokens)" ;;
  revoke)
    [ -n "${1:-}" ] || die "usage: gwm web revoke <token-name> | --all"
    if [ "$1" = --all ]; then zellij web --revoke-all-tokens; else zellij web --revoke-token "$1"; fi ;;
  *) die "usage: gwm web [start|stop|status|token [--read-only]|tokens|revoke <name>|--all]" ;;
  esac
}

# ---------- adding machines ----------
discover() {  # print "address<TAB>description" for machines we can see: Tailscale peers + Macs on this Wi-Fi with Remote Login on
  tailscale status --json 2>/dev/null | python3 -c '
import sys, json
d = json.load(sys.stdin)
for p in (d.get("Peer") or {}).values():
    name = p.get("DNSName", "").rstrip(".")
    if name: print(f"{name}\tTailscale · {p.get(\"OS\",\"?\")} · {\"online\" if p.get(\"Online\") else \"offline\"}")' 2>/dev/null
  local mine; mine="$(scutil --get LocalHostName 2>/dev/null)"
  perl -e 'alarm 3; exec @ARGV' dns-sd -B _ssh._tcp local. 2>/dev/null | awk 'NR>4 && $2=="Add" {$1=$2=$3=$4=$5=$6=""; sub(/^ +/,""); print}' | sort -u |
  while IFS= read -r inst; do
    ( perl -e 'alarm 3; exec @ARGV' dns-sd -L "$inst" _ssh._tcp local. 2>/dev/null | grep -o 'reached at [^ ]*' | head -1 |
        awk -v i="$inst" '{h=$3; sub(/:[0-9]+$/,"",h); sub(/\.$/,"",h); printf "%s\tsame Wi-Fi · %s\n", h, i}' ) &
  done | grep -v "^$mine\.local" ; wait
}
cmd_add() {
  local n="" addr="" user="" role="" yes="" via=""
  while [ $# -gt 0 ]; do case "$1" in
    --address) addr="$2"; shift 2;; --user) user="$2"; shift 2;; --role) role="$2"; shift 2;; -y|--yes) yes=1; shift;;
    --via) via="$2"; shift 2;;
    *) n="$1"; shift;; esac; done
  [ -n "$(self_name)" ] || die "run 'gwm init' on this machine first"
  local me mytarget; me="$(self_name)"; mytarget="$(hfield "$me" 2)"
  echo "$(c 1)Add a machine to go-with-me$(c 0)"

  # 0. how do we connect? Tailscale SSH (no Remote Login, works anywhere) or Remote Login (plain SSH)
  case "$via" in tailscale|ts) via=tailscale;; ssh|remote-login) via=ssh;; "") ;; *) die "--via must be tailscale or ssh";; esac
  if [ -z "$via" ] && [ -n "$addr" ]; then
    case "$addr" in *.ts.net|100.*) via=tailscale;; *) via=ssh;; esac
  fi
  if [ -z "$via" ]; then
    echo "How should go-with-me connect to it?"
    echo "  1) $(c 1)Tailscale$(c 0)     no Remote Login, no keys, works from anywhere  $(c 2)(recommended)$(c 0)"
    echo "  2) $(c 1)Remote Login$(c 0)  plain SSH — same Wi-Fi, or any address you can already SSH to"
    case "$(ask "Choose" 1)" in 2|ssh|r*) via=ssh;; *) via=tailscale;; esac
  fi
  if [ "$via" = tailscale ] && ! ts_running; then
    echo "$(c 33)•$(c 0) Tailscale isn't running on this Mac yet. Set it up with:  $(c 1)gwm tailscale$(c 0)   (then run gwm add again)"
    echo "  Or use Remote Login instead:  gwm add --via ssh"; exit 1
  fi

  # 1. where is it?
  if [ -z "$addr" ]; then
    echo "Looking for machines…"
    local found; found="$(discover | if [ "$via" = tailscale ]; then grep -F 'Tailscale'; else cat; fi)"
    if [ -n "$found" ]; then
      printf '%s\n' "$found" | awk -F'\t' '{printf "  %d) %-40s %s\n", NR, $1, $2}'
      local pick; pick="$(ask "Pick a number, or type an address" 1)"
      if [[ "$pick" =~ ^[0-9]+$ ]]; then addr="$(printf '%s\n' "$found" | sed -n "${pick}p" | cut -f1)"; else addr="$pick"; fi
    else
      [ "$via" = tailscale ] && echo "  (no other Tailscale machines found — sign the other Mac in to the same Tailscale account, or type its name)" \
                             || echo "  (nothing found — type its .local name or IP)"
      addr="$(ask "Address" "")"
    fi
  fi
  [ -n "$addr" ] || die "no address given"
  addr="${addr#*@}"

  # 2. can we reach it at all?
  if ! nc -z -G 4 "$addr" 22 >/dev/null 2>&1; then
    echo "$(c 31)✗$(c 0) $addr isn't accepting SSH connections."
    if [ "$via" = tailscale ]; then
      echo "  On that Mac, run $(c 1)gwm tailscale$(c 0) (or: sudo tailscale set --ssh) to turn on Tailscale SSH, then run gwm add again."
    else
      echo "  On that Mac: System Settings → General → Sharing → turn on $(c 1)Remote Login$(c 0), then run gwm add again."
      echo "  (Away from home? Use Tailscale instead: gwm add --via tailscale)"
    fi; exit 1
  fi
  echo "$(c 32)✓$(c 0) $addr is reachable ($([ "$via" = tailscale ] && echo "Tailscale SSH" || echo "Remote Login"))"

  # 3. which user?
  [ -n "$user" ] || { [ -n "$yes" ] && user="$(whoami)"; } || true
  [ -n "$user" ] || user="$(ask "Your username on that Mac (run 'whoami' there if unsure)" "$(whoami)")"
  local t="$user@$addr"
  local sshq=(ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ConnectTimeout=6 -o LogLevel=ERROR)

  # 4. log in. Tailscale SSH: no keys — Tailscale vouches for you. Remote Login: copy this Mac's key once.
  if [ "$via" = tailscale ]; then
    if ! "${sshq[@]}" "$t" true 2>/dev/null; then
      echo "$(c 31)✗$(c 0) Tailscale SSH refused the login as '$user'. Usually one of:"
      echo "  • your tailnet's SSH rule is in \"check\" mode (asks for a browser login every 12h) — switch it to \"accept\":"
      echo "    https://login.tailscale.com/admin/acls → in \"ssh\", set \"action\": \"accept\"   (details: docs/SETUP.md)"
      echo "  • wrong username — run 'whoami' on that Mac and try: gwm add --via tailscale --user <name> --address $addr"; exit 1
    fi
  else
  ensure_key >/dev/null
  if ! "${sshq[@]}" "$t" true 2>/dev/null; then
    if ! ssh-keygen -F "$addr" >/dev/null 2>&1; then   # first contact: make sure it's really your Mac before typing a password
      echo "First time connecting to $addr. Its fingerprint:"
      ssh-keyscan -T 5 -t ed25519 "$addr" 2>/dev/null | ssh-keygen -lf - 2>/dev/null | sed 's/^/  /'
      echo "  To check, run on that Mac:  ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub"
      if [ -z "$yes" ]; then [ "$(ask "Does it match? (y/n)" n)" = y ] || die "not sending your password to an unverified machine"; fi
    fi
    echo "This Mac's key isn't trusted there yet. Copying it now — enter $(c 1)$user's password on $addr$(c 0) once:"
    ssh-copy-id -o StrictHostKeyChecking=accept-new -i "$HOME/.ssh/id_ed25519.pub" "$t" >/dev/null 2>&1 </dev/tty || true
    if ! "${sshq[@]}" "$t" true 2>/dev/null; then
      echo "$(c 31)✗$(c 0) Still can't log in as '$user'. Common causes:"
      echo "  • wrong username — run 'whoami' on that Mac and try: gwm add --user <name> --address $addr"
      echo "  • Remote Login limited to some users — Sharing → Remote Login → ⓘ → Allow access for: All users"; exit 1
    fi
  fi
  fi
  echo "$(c 32)✓$(c 0) Logged in as $user"

  # 5. what is it?
  local info; info="$(run_script_target "$t" 'echo "host=$(scutil --get LocalHostName 2>/dev/null || hostname -s)"; echo "os=$(sw_vers -productVersion 2>/dev/null || uname -sr)"
    echo "ram=$(( $(sysctl -n hw.memsize 2>/dev/null || echo 0) / 1073741824 ))"; echo "model=$(sysctl -n hw.model 2>/dev/null || uname -m)"
    for x in brew tmux zellij claude opencode ollama limactl tailscale; do command -v $x >/dev/null && echo "has=$x"; done')"
  local rhost ros rram rmodel; rhost="$(sed -n 's/^host=//p' <<<"$info")"; ros="$(sed -n 's/^os=//p' <<<"$info")"
  rram="$(sed -n 's/^ram=//p' <<<"$info")"; rmodel="$(sed -n 's/^model=//p' <<<"$info")"
  has() { grep -qx "has=$1" <<<"$info"; }
  printf "$(c 32)✓$(c 0) %s · %s · %sGB · " "$rhost" "$ros" "$rram"
  for x in tmux claude opencode ollama; do has $x && printf "%s ✓ " "$x" || printf "$(c 2)%s ✗$(c 0) " "$x"; done; echo
  if ! has tmux; then
    if has brew && { [ -n "$yes" ] || [ "$(ask "tmux is needed to keep sessions running there. Install it now? (y/n)" y)" = y ]; }; then
      run_script_target "$t" 'brew install tmux >/dev/null 2>&1 && echo ok' | grep -q ok && echo "$(c 32)✓$(c 0) installed tmux" || echo "$(c 33)•$(c 0) couldn't install tmux — run 'brew install tmux' there"
    else echo "$(c 33)•$(c 0) install tmux there (brew install tmux) before opening sessions on it"; fi
  fi

  # 6. name + save
  [ -n "$n" ] || n="$(ask "Short name for it" "$(echo "$rhost" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9-]//g' | sed 's/^.*s-//' | cut -c1-20)")"
  [[ "$n" =~ ^[A-Za-z0-9_-]+$ ]] || die "name: letters, digits, - and _ only"
  [ "$n" = "$me" ] && die "'$n' is this machine's name — pick another"
  [ -n "$role" ] || role="$rmodel, ${rram}GB"
  upsert_host "$n" "$t" "$role"
  echo "$(c 32)✓$(c 0) Saved as '$n' → $t"

  # 7. the other direction: it → this machine (for gwm on that machine, and its board)
  local rkey=""
  if [ "$via" = tailscale ]; then
    case "$mytarget" in *.ts.net|*@100.*) ;; *) echo "$(c 33)•$(c 0) This Mac is saved as $mytarget — run $(c 1)gwm tailscale$(c 0) here so '$n' can reach it over Tailscale too";; esac
    run_script_target "$t" "ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ConnectTimeout=6 -o LogLevel=ERROR $mytarget true && echo back-ok" 2>/dev/null | grep -q back-ok &&
      echo "$(c 32)✓$(c 0) '$n' can reach this Mac too" || echo "$(c 33)•$(c 0) '$n' can't reach this Mac yet — run gwm tailscale here (it turns on Tailscale SSH)"
  else
    rkey="$(run_script_target "$t" '[ -f ~/.ssh/id_ed25519.pub ] || ssh-keygen -q -t ed25519 -N "" -C "go-with-me@'"$n"'" -f ~/.ssh/id_ed25519; cat ~/.ssh/id_ed25519.pub')"
  fi
  rkey="$(printf '%s\n' "$rkey" | grep -E '^ssh-ed25519 [A-Za-z0-9+/=]+( [A-Za-z0-9_.@:-]+)?$' | head -1)"
  if [ -n "$rkey" ] && ! grep -qF "${rkey%% go-with-me*}" "$HOME/.ssh/authorized_keys" 2>/dev/null && [ -z "$yes" ] &&
     [ "$(ask "Let '$n' connect back to this Mac (adds its SSH key here)? (y/n)" y)" != y ]; then rkey=""; echo "  skipped — '$n' won't be able to reach this Mac"; fi
  if [ -n "$rkey" ]; then
    mkdir -p "$HOME/.ssh"; touch "$HOME/.ssh/authorized_keys"; chmod 600 "$HOME/.ssh/authorized_keys"
    grep -qF "$rkey" "$HOME/.ssh/authorized_keys" || echo "$rkey" >> "$HOME/.ssh/authorized_keys"
    if run_script_target "$t" "ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ConnectTimeout=6 -o LogLevel=ERROR $mytarget true && echo back-ok" 2>/dev/null | grep -q back-ok; then
      echo "$(c 32)✓$(c 0) '$n' can reach this Mac too"
    else
      echo "$(c 33)•$(c 0) '$n' can't reach this Mac yet — turn on Remote Login here (System Settings → General → Sharing)"
    fi
  fi

  # 8. install go-with-me there with the same config
  if [ -n "$yes" ] || [ "$(ask "Install go-with-me on '$n' too, so you can open the hub from there? (y/n)" y)" = y ]; then
    run_script_target "$t" '[ -e ~/go-with-me ] && [ ! -f ~/go-with-me/go-with-me ] && echo NOT_GWM' | grep -q NOT_GWM &&
      die "~/go-with-me on '$n' exists but isn't go-with-me — not overwriting it"
    run_script_target "$t" 'for f in hosts.conf sessions.conf self coordinator; do [ -f ~/.config/go-with-me/$f ] && cp ~/.config/go-with-me/$f ~/.config/go-with-me/$f.bak; done; true' >/dev/null 2>&1
    rsync -a --delete --exclude .DS_Store --exclude .git -e "ssh -o BatchMode=yes -o LogLevel=ERROR" "$DIR/" "$t:go-with-me/" &&
    run_script_target "$t" "mkdir -p ~/.config/go-with-me/accounts" &&
    scp -q -o BatchMode=yes "$HOSTS" "$SESSIONS" "$t:.config/go-with-me/" &&
    run_script_target "$t" "~/go-with-me/install.sh >/dev/null && echo $n > ~/.config/go-with-me/self && echo ok" | grep -q ok &&
      echo "$(c 32)✓$(c 0) go-with-me installed on '$n' (run gwm there)" || echo "$(c 33)•$(c 0) couldn't install go-with-me there — see docs/SETUP.md"
    # keep every other machine's copy of the config in sync
    while IFS=$'\t' read -r h ht _; do
      [ "$h" = "$me" ] || [ "$h" = "$n" ] && continue; case "$ht" in vm:*) continue;; esac
      run_script "$h" 'for f in hosts.conf sessions.conf; do [ -f ~/.config/go-with-me/$f ] && cp ~/.config/go-with-me/$f ~/.config/go-with-me/$f.bak; done; true' >/dev/null 2>&1
      scp -q -o BatchMode=yes -o ConnectTimeout=4 "$HOSTS" "$SESSIONS" "$ht:.config/go-with-me/" 2>/dev/null
    done < <(hosts)
  fi

  # 9. a tab for it
  if ! sessions | awk -F'\t' -v h="$n" '$2==h{f=1} END{exit !f}'; then
    if [ -z "$yes" ] && [ "$(ask "Also save a Claude Code session on '$n'? (y/n)" n)" = y ]; then
      printf '%-14s| %-8s| %-9s| %-8s| %s\n' "$n" "$n" claude default "~" >> "$SESSIONS"; echo "$(c 32)✓$(c 0) Added session '$n'"
    fi
  fi
  echo; echo "Done — '$n' is on your board.  gwm status  ·  gwm  ·  gwm open $n"
}
run_script_target() {  # like run_script, but for a raw user@address that isn't saved yet
  printf '%s\n%s\n' "$PATHFIX" "$2" | ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ConnectTimeout=6 -o LogLevel=ERROR "$1" 'exec "$SHELL" -l -s'
}
cmd_remove() {
  local n="${1:-}"; [ -n "$n" ] || die "usage: gwm remove <machine>"; need_host "$n"
  [ "$n" = "$(self_name)" ] && die "can't remove this machine"
  awk -F'|' -v n="$n" '{v=$1; gsub(/^[[:space:]]+|[[:space:]]+$/,"",v)} v!=n' "$HOSTS" > "$HOSTS.new" && mv "$HOSTS.new" "$HOSTS"
  awk -F'|' -v n="$n" '{v=$2; gsub(/^[[:space:]]+|[[:space:]]+$/,"",v)} v!=n' "$SESSIONS" > "$SESSIONS.new" && mv "$SESSIONS.new" "$SESSIONS"
  echo "$(c 32)✓$(c 0) Removed '$n' and its sessions from this machine's config (nothing on '$n' was changed)."
}
cmd_sync() { local h="$1"; need_host "$h"
  for f in hosts.conf sessions.conf; do run_script "$h" "cat ~/.config/go-with-me/$f" > "$CFG/$f.new" && mv "$CFG/$f.new" "$CFG/$f"; done
  echo "Copied hosts + sessions config from $h."; }

# check the config once per command (warnings), then read it quietly everywhere else
if [ -z "${GWM_QUIET:-}" ] && [ -f "$HOSTS" ] && [ -f "$SESSIONS" ]; then hosts >/dev/null; sessions >/dev/null; fi
export GWM_QUIET=1
case "${1:-open}" in
  open) if [ $# -ge 2 ]; then cmd_open_session "$2"; else cmd_open; fi ;;  board) cmd_board ;;  status) print_table ;;
  kill) zellij kill-session "$HUBNAME" >/dev/null 2>&1; zellij delete-session "$HUBNAME" >/dev/null 2>&1; echo "Hub closed. Sessions keep running on their machines." ;;
  who) cmd_who ;;
  attach-coordinator) cmd_attach_coordinator ;;
  coordinator) shift; cmd_coordinator "$@" ;;
  history) shift; cmd_history "$@" ;;
  new) shift; cmd_new "$@" ;;
  close) shift; cmd_close "$@" ;;
  stop|restart) [ $# -ge 2 ] || die "usage: gwm stop <session>"; cmd_stop "$2" ;;
  sessions) sessions | awk -F'\t' 'BEGIN{printf "%-14s %-10s %-9s %-10s %s\n","SESSION","HOST","ENGINE","ACCOUNT","FOLDER"} {printf "%-14s %-10s %-9s %-10s %s\n",$1,$2,$3,$4,$5}' ;;
  hosts) hosts | awk -F'\t' '{printf "%-12s %-28s %s\n",$1,$2,$3}' ;;
  attach)  [ $# -ge 2 ] || die "usage: gwm attach <session>"; cmd_attach "$2" ;;
  peek)    [ $# -ge 2 ] || die "usage: gwm peek <session> [lines]"; cmd_peek "$2" "${3:-40}" ;;
  send)    [ $# -ge 3 ] || die "usage: gwm send <session> <text>"; shift; cmd_send "$@" ;;
  run)     [ $# -ge 3 ] || die "usage: gwm run <host> <command>"; shift; cmd_run "$@" ;;
  doctor) cmd_doctor ;;
  accounts) shift; cmd_accounts "$@" ;;  login) shift; cmd_login "$@" ;;
  vm) shift; cmd_vm "$@" ;;
  models) shift; cmd_models "$@" ;;  pull) shift; cmd_pull "$@" ;;  opencode-setup) shift; cmd_opencode_setup "$@" ;;
  discover) discover ;;
  _data) cmd_data ;;
  pick) cmd_pick ;;
  _startcmd) need_session "$2"; start_cmd "$2" ;;
  _shell) unset $CLAUDE_MARKERS; [ "${2:-}" = coordinator ] && printf '\033[38;5;209;1m✻ coordinator\033[0;2m — a terminal that can see every machine. Type \033[0;1mclaude\033[0;2m to ask it to summarise or delegate\n  (it reads coordinator/CLAUDE.md), or use gwm status · gwm peek · gwm send yourself.\033[0m\n\n'
          exec "${SHELL:-/bin/zsh}" -l ;;
  sidebar) exec python3 "$DIR/sidebar.py" "$ME" ;;
  tailscale) cmd_tailscale ;;
  keys) shift; cmd_keys "$@" ;;
  web) shift; cmd_web "$@" ;;
  init) cmd_init "${2:-}" ;;  add) shift; cmd_add "$@" ;;  remove) [ $# -ge 2 ] || die "usage: gwm remove <machine>"; cmd_remove "$2" ;;  sync) [ $# -ge 2 ] || die "usage: gwm sync <host> | gwm sync --push"
        if [ "$2" = --push ]; then sessions >/dev/null; while IFS=$'\t' read -r n _; do sync_session add "$n" "$(grep -E "^[[:space:]]*$n[[:space:]]*\|" "$SESSIONS" | head -1)"; done < <(sessions); echo "$(c 32)✓$(c 0) sent any missing sessions to every machine"
        else cmd_sync "$2"; fi ;;
  edit) ${EDITOR:-nano} "$HOSTS" "$SESSIONS" ;;
  -h|--help|help) awk 'NR>1 && /^#/{sub(/^# ?/,""); print; next} NR>1{exit}' "$ME" ;;
  *) die "unknown command '$1' (gwm help)" ;;
esac
