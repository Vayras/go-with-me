#!/bin/bash
# go-with-me — one terminal for all your machines, accounts, VMs and models.
#
#   "overview" tab: live board of every machine + session, and a coordinator Claude that can see/steer them all.
#   One tab per session. A session = a machine + an engine (claude | opencode | shell) + an account + a folder.
#   Sessions keep running on their machine when you disconnect. The hub runs in Zellij (shortcuts shown on screen).
#
# Hub
#   gwm                               open the hub (or re-attach). Only running sessions get a tab.
#   gwm status | board                one-shot status / live board
#   gwm who                           which other devices are using each machine right now
#   gwm kill                          close the hub (sessions keep running)
#   gwm coordinator [machine]         show / set which machine the shared coordinator lives on
#   gwm keys [--setup]                show the shortcuts (--setup: make ⌥ work in Terminal.app)
#   gwm demo                          try it: the hub with pretend machines (no setup needed)
# Web (same hub in a browser, on your tailnet only)
#   gwm web                           start: loopback server + Tailscale Serve (HTTPS) + login token
#   gwm web stop|status               stop sharing / show what's running and the link
#   gwm web token [--read-only]       new login token · gwm web tokens · gwm web revoke <name>|--all
# Sessions
#   gwm new [name] [--on machine] [--engine e] [--account a] [--folder f]   start a session (asks what's missing)
#                                     --on can be any machine on your tailnet: if it's new, gwm sets it up first
#   gwm tailnet                       every machine on your tailnet, and which ones go-with-me already knows
#   gwm open <session>                open a tab for a session that isn't running/open yet (starts it)
#   gwm close <session> [--yes]       stop a session and remove its tab (its screen + conversation are kept)
#   gwm archive                       closed sessions you can bring back · gwm resume <session>
#   gwm spawn <name> --on <machine> [--engine e] [--prompt "task"]   start a session with its agent running
#   gwm stop <session>                stop what's running but keep the tab (Enter in the tab restarts it)
#   gwm sessions                      list sessions
#   gwm peek <session> [lines]        show a session's screen
#   gwm send <session> <text...>      type text + Enter into a session
#   gwm history <session>|--all [n]   the session's Claude conversation (last n messages, from its machine)
#   gwm attach <session>              connect to a session in this terminal (what each tab runs)
# Files + browser (for sessions on other machines)
#   gwm paste [session] [--last]      this Mac's clipboard (screenshot / copied files) → that session's machine, path typed in (⌥V)
#   gwm share <file|session:path|machine:path>… <to-session> [--no-type]   copy files to a session's machine
#   gwm chrome [start|stop|status] [--to machine]   a Chrome window here that Claude on every machine can drive
# Machines
#   gwm hosts                         list machines
#   gwm run <host> <command...>       run a shell command on a machine
#   gwm doctor                        check every machine is reachable and ready
# Accounts (separate Claude logins, e.g. personal + work)
#   gwm accounts [--on host]          show which account is logged in where
#   gwm login <account> [--on host]   sign an account in on a host
# VMs (Linux, via Lima — run them on your strongest machine)
#   gwm vm create <name> [--on host] [--cpus N] [--memory GB] [--disk GB]
#   gwm vm list|start|stop|delete [name] [--on host]
# Local models (oMLX or Ollama) + opencode
#   gwm models [--on host]            installed + loaded models (oMLX when it runs there, else Ollama)
#   gwm pull <model> [--on host]      download a model (org/name = Hugging Face MLX repo into oMLX; else Ollama)
#   gwm opencode-setup [--on host] [--model name]   point opencode at that host's oMLX (or Ollama)
# Setup
#   gwm init [name]                   one-time on each machine: name it and create its config
#   gwm tailscale                     set up Tailscale + Tailscale SSH on this Mac (then no Remote Login needed)
#   gwm add [--via tailscale|ssh]     add another machine (guided): Tailscale, or Remote Login with SSH keys
#                                     set up both ways; installs tmux + go-with-me there, adds a tab
#   gwm remove <machine>              remove a machine from your config
#   gwm sync <host>                   copy hosts/sessions config from another host
#   gwm sync --push                   add this machine's sessions to every other machine (nothing is removed)
#   gwm edit                          open the config files in your editor

set -u
SCRIPT="$(readlink "$0" 2>/dev/null || echo "$0")"
case "$SCRIPT" in /*) ;; *) SCRIPT="$(cd "$(dirname "$0")" && pwd)/$(basename "$SCRIPT")";; esac
DIR="$(cd "$(dirname "$SCRIPT")" && pwd)"
ME="$DIR/go-with-me"
CFG="${GWM_CONFIG:-$HOME/.config/go-with-me}"
if [ "${1:-}" = demo ]; then   # `gwm demo`: the real hub with pretend machines — no SSH, no logins, nothing real touched
  export GWM_DEMO=1 GWM_HUB=gwm-demo GWM_CONFIG="$(mktemp -d "${TMPDIR:-/tmp}/go-with-me-demo.XXXXXX")"
  trap 'rm -rf "$GWM_CONFIG"' EXIT
  cp "$DIR/demo/hosts.conf" "$DIR/demo/sessions.conf" "$GWM_CONFIG/"; echo studio > "$GWM_CONFIG/self"
  CFG="$GWM_CONFIG"; shift; [ $# -gt 0 ] || set -- open   # `gwm demo status` etc. also work on the pretend data
fi
HOSTS="$CFG/hosts.conf"; SESSIONS="$CFG/sessions.conf"; SELF_FILE="$CFG/self"
PFX=gwm-
ACCT_DIR='$HOME/.config/go-with-me/accounts'   # expanded on the target host
export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$PATH"

c() { [ -t 1 ] && printf '\033[%sm' "$1" || true; }
die() { echo "go-with-me: $*" >&2; exit 1; }
b64() { printf '%s' "$1" | base64 | tr -d '\n'; }
self_name() { [ -f "$SELF_FILE" ] && cat "$SELF_FILE" || true; }

# ---------- config ----------
# Config values end up inside commands on other machines, so only safe characters are accepted.
NAME_RE='^[A-Za-z0-9_.-]+$'; FOLDER_RE='^[A-Za-z0-9_./~ -]+$'; MODEL_RE='^[A-Za-z0-9_.:/@-]+$'
TARGET_RE='^([A-Za-z0-9_.-]+@)?[A-Za-z0-9_.:-]+$|^vm:[A-Za-z0-9_.-]+/[A-Za-z0-9_-]+$'
hosts() {    # name target role (single-pass awk validation)
  [ -f "$HOSTS" ] || die "missing $HOSTS — run: gwm init <this-host-name>"
  awk -F'|' -v q="${GWM_QUIET:-}" -v nr="$NAME_RE" -v tr="$TARGET_RE" '
    /^[[:space:]]*#/||/^[[:space:]]*$/{next}
    {for(i=1;i<=3;i++){f[i]=$i; gsub(/^[[:space:]]+|[[:space:]]+$/,"",f[i])}
     if(f[1] ~ nr && f[2] ~ tr) printf "%s\t%s\t%s\n", f[1], f[2], f[3]
     else if(!q) printf "go-with-me: skipping machine '\''%s'\'' in hosts.conf (unsafe characters in its name or address)\n", f[1] > "/dev/stderr"}' "$HOSTS"
}
sessions() { # name host engine account folder (single-pass awk validation)
  [ -f "$SESSIONS" ] || die "missing $SESSIONS — run: gwm init <this-host-name>"
  awk -F'|' -v q="${GWM_QUIET:-}" -v nr="$NAME_RE" -v fr="$FOLDER_RE" '
    /^[[:space:]]*#/||/^[[:space:]]*$/{next}
    {for(i=1;i<=5;i++){f[i]=$i; gsub(/^[[:space:]]+|[[:space:]]+$/,"",f[i])}
     if(f[5]=="") f[5]="~"
     if(f[1] ~ nr && f[1]!="coordinator" && f[2] ~ nr && f[3] ~ nr && (f[4]=="-" || f[4] ~ nr) && f[5] ~ fr)
       printf "%s\t%s\t%s\t%s\t%s\n", f[1], f[2], f[3], f[4], f[5]
     else if(!q) printf "go-with-me: skipping session '\''%s'\'' in sessions.conf (unsafe characters, or the reserved name '\''coordinator'\'')\n", f[1] > "/dev/stderr"}' "$SESSIONS"
}
qfolder() {  # a folder as a double-quoted shell word for the remote side ("~/x" -> "$HOME/x"); safe because folders are validated
  local f="${1:-~}"; case "$f" in "~") f='$HOME';; "~/"*) f='$HOME/'"${f#\~/}";; esac; printf '"%s"' "$f"
}
hfield() { hosts    | awk -F'\t' -v n="$1" -v f="$2" '$1==n{print $f; ok=1; exit} END{exit !ok}'; }
sfield() { sessions | awk -F'\t' -v n="$1" -v f="$2" '$1==n{print $f; ok=1; exit} END{exit !ok}'; }
need_host()    { hfield "$1" 1 >/dev/null || die "unknown host '$1' (gwm hosts)"; }
need_session() { sfield "$1" 1 >/dev/null || die "unknown session '$1' (gwm sessions)"; }
is_local() { [ "$1" = "$(self_name)" ]; }
is_uint()  { [[ "$1" =~ ^[0-9]+$ ]] && [ "$1" -gt 0 ]; }
mtime()    { stat -f %m "$1" 2>/dev/null || stat -c %Y "$1" 2>/dev/null || echo 0; }
# Atomic config helpers: prevent concurrent probe/new/close/add writes from corrupting config files
cfg_lock() {
  local l="$CFG/.cfg-lock" i=0
  [ -d "$l" ] && [ $(( $(date +%s) - $(mtime "$l") )) -gt 30 ] && rmdir "$l" 2>/dev/null || true
  while ! mkdir "$l" 2>/dev/null; do i=$((i+1)); [ $i -ge 50 ] && return 1; sleep 0.05; done
}
cfg_unlock() { rmdir "$CFG/.cfg-lock" 2>/dev/null || true; }
filter_conf() {  # filter_conf <file> <col> <drop-value> [extra-col2-regex]
  local file="$1" col="$2" val="$3" re="${4:-}" tmp locked=0
  cfg_lock && locked=1
  tmp="$(mktemp "$file.XXXXXX")" || { [ $locked -eq 1 ] && cfg_unlock; return 1; }
  awk -F'|' -v c="$col" -v n="$val" -v re="$re" '
    {v=$c; gsub(/^[[:space:]]+|[[:space:]]+$/,"",v); t=$2; gsub(/^[[:space:]]+|[[:space:]]+$/,"",t)}
    !(v==n && (re=="" || t ~ re))' "$file" > "$tmp" && mv "$tmp" "$file" || rm -f "$tmp"
  [ $locked -eq 1 ] && cfg_unlock
}
# Tombstones for closed sessions (30-day TTL) so adopt_sessions never resurrects a session closed while its host slept
CLOSED_FILE="$CFG/.closed"
mark_closed() {
  local n="$1" now locked=0 tmp; now="$(date +%s)"
  cfg_lock && locked=1
  tmp="$(mktemp "$CFG/.closed.XXXXXX")"
  { [ -f "$CLOSED_FILE" ] && awk -F'|' -v n="$n" -v cut="$((now - 2592000))" '$1!=n && $2+0>=cut' "$CLOSED_FILE"; printf '%s|%s\n' "$n" "$now"; } > "$tmp" && mv "$tmp" "$CLOSED_FILE" || rm -f "$tmp"
  [ $locked -eq 1 ] && cfg_unlock
}
clear_closed() {
  [ -f "$CLOSED_FILE" ] || return 0
  local locked=0 tmp
  cfg_lock && locked=1
  tmp="$(mktemp "$CFG/.closed.XXXXXX")"
  awk -F'|' -v n="$1" '$1!=n' "$CLOSED_FILE" > "$tmp" && mv "$tmp" "$CLOSED_FILE" || rm -f "$tmp"
  [ $locked -eq 1 ] && cfg_unlock
}

# ---------- running things on hosts ----------
PATHFIX='export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"'
CLAUDE_MARKERS="CLAUDECODE CLAUDE_PID CLAUDE_EFFORT CLAUDE_CODE_CHILD_SESSION CLAUDE_CODE_CHILD_NOTES_DIR CLAUDE_CODE_ENTRYPOINT CLAUDE_CODE_EXECPATH CLAUDE_CODE_MESSAGING_SOCKET CLAUDE_CODE_MESSAGING_TOKEN CLAUDE_CODE_SESSION_ATTENDED CLAUDE_CODE_SESSION_ID CLAUDE_CODE_SSE_PORT"
scrub_env() {
  local v; for v in $(env | sed -n 's/^\(CLAUDECODE\|CLAUDE_CODE_[A-Z_]*\)=.*/\1/p'); do unset "$v"; done
  unset TERM_SESSION_ID SHELL_SESSION_ID SHELL_SESSION_DID_INIT SHELL_SESSION_FILE $CLAUDE_MARKERS
}
SSH_CTL_DIR="/tmp/gwm-ssh-$(id -u)"
SSH_BASE=(-o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ConnectTimeout=4 -o ServerAliveInterval=5 -o ServerAliveCountMax=2)
SSH_MUX=()
if [ "${GWM_SSH_MUX:-1}" != 0 ]; then
  [ -d "$SSH_CTL_DIR" ] || mkdir -p -m 700 "$SSH_CTL_DIR" 2>/dev/null || true
  if [ -d "$SSH_CTL_DIR" ] && [ -O "$SSH_CTL_DIR" ] && [ ! -L "$SSH_CTL_DIR" ]; then
    SSH_MUX=(-o ControlMaster=auto -o ControlPersist=15 -o "ControlPath=$SSH_CTL_DIR/%C")
  fi
fi
vm_split() { VM_PARENT="${1#vm:}"; VM_PARENT="${VM_PARENT%%/*}"; VM_NAME="${1#*/}"; }
ts_self_dns() { tailscale status --json 2>/dev/null | python3 -c 'import sys,json; print(json.load(sys.stdin)["Self"]["DNSName"].rstrip("."))' 2>/dev/null; }
# run_script <host> <script>   non-interactive; works for this machine, SSH hosts and Lima VMs
run_script() {
  [ -n "${GWM_DEMO:-}" ] && return 0
  local h="$1" s="$PATHFIX
$2" t; t="$(hfield "$h" 2)"
  case "$t" in
    vm:*) vm_split "$t"
          run_script "$VM_PARENT" "limactl shell --workdir / $VM_NAME -- bash -l -c \"\$(printf %s $(b64 "$s") | base64 -d)\"" ;;
    *) if is_local "$h"; then printf '%s\n' "$s" | env -u TMUX "${SHELL:-/bin/zsh}" -l -s
       else printf '%s\n' "$s" | ssh "${SSH_BASE[@]}" ${SSH_MUX[@]+"${SSH_MUX[@]}"} -o LogLevel="${GWM_SSH_LOGLEVEL:-ERROR}" "$t" 'exec "$SHELL" -l -s'; fi ;;
  esac
}
# run_tty <host> <command>   interactive (needs a terminal)
run_tty() {
  local h="$1" s="$PATHFIX; $2" t; t="$(hfield "$h" 2)"
  case "$t" in
    vm:*) vm_split "$t"
          run_tty "$VM_PARENT" "limactl shell --workdir / $VM_NAME -- bash -l -c \"\$(printf %s $(b64 "$s") | base64 -d)\"" ;;
    *) if is_local "$h"; then env -u TMUX -u TERM_SESSION_ID -u SHELL_SESSION_ID "${SHELL:-/bin/zsh}" -lc "$s"
       else ssh -t -o StrictHostKeyChecking=accept-new -o ConnectTimeout=5 -o ServerAliveInterval=10 -o ServerAliveCountMax=3 -o LogLevel=ERROR \
              "$t" "exec \"\$SHELL\" -lc \"\$(printf %s $(b64 "$s") | base64 -d)\""; fi ;;
  esac
}
# has_cmd <host> <program>: is it installed there? (checked by output — remote login shells don't pass exit codes back reliably)
has_cmd() { run_script "$1" "command -v $2 >/dev/null 2>&1 && echo GWM_FOUND" 2>/dev/null | grep -q GWM_FOUND; }
# --on <host> option parsing (default: this machine)
ON=""; ARGS=()
parse_on() { ON="$(self_name)"; ARGS=(); while [ $# -gt 0 ]; do
  case "$1" in --on) [ $# -ge 2 ] || die "--on needs a machine"; ON="$2"; shift 2;; *) ARGS+=("$1"); shift;; esac; done; need_host "$ON"; }

# ---------- status ----------
PROBE='
if [ "$(uname)" = Darwin ]; then
  nc=$(sysctl -n hw.ncpu 2>/dev/null || echo 1)
  cpu=$(ps -A -o %cpu= 2>/dev/null | awk -v n="$nc" "{s+=\$1} END{u=int(s/n+0.5); if(u>100)u=100; printf \"%d%%\", u}")
  pg=$(sysctl -n hw.pagesize); tot=$(( $(sysctl -n hw.memsize) / 1073741824 ))
  used=$(vm_stat | awk -v ps=$pg "/Anonymous pages/{a=\$3} /wired down/{w=\$4} /occupied by compressor/{c=\$5} END{gsub(/\\./,\"\",a);gsub(/\\./,\"\",w);gsub(/\\./,\"\",c); printf \"%.0f\", (a+w+c)*ps/1073741824}")
  gpu=$(ioreg -r -d 1 -w 0 -c IOAccelerator 2>/dev/null | grep -o "\"Device Utilization %\"=[0-9]*" | head -1 | cut -d= -f2)
else
  read -r _ a b c d _ < /proc/stat; sleep 0.25; read -r _ a2 b2 c2 d2 _ < /proc/stat
  cpu="$(( 100 * ((a2+b2+c2)-(a+b+c)) / ((a2+b2+c2+d2)-(a+b+c+d) + 1) ))%"
  tot=$(awk "/MemTotal/{printf \"%.0f\", \$2/1048576}" /proc/meminfo)
  used=$(awk "/MemTotal/{t=\$2} /MemAvailable/{a=\$2} END{printf \"%.0f\", (t-a)/1048576}" /proc/meminfo)
  gpu=$(command -v nvidia-smi >/dev/null && nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits 2>/dev/null | head -1 | tr -d " ")
fi
# loaded local models from oMLX (:8000) and Ollama (:11434), whichever run here: M|name|GB|format lines
ml=$(python3 -c "import json, os, urllib.request as u
kf = os.path.expanduser(\"~/.omlx/api_key\")
key = open(kf).read().strip() if os.path.exists(kf) else \"\"
def get(url):
    try: return json.load(u.urlopen(u.Request(url, headers={\"Authorization\": \"Bearer \" + key} if key else {}), timeout=1))
    except Exception: return {}
for m in get(\"http://127.0.0.1:8000/v1/models/status\").get(\"models\", []):
    if m.get(\"loaded\"): print(\"M|%s|%.1f|omlx\" % (m[\"id\"], (m.get(\"actual_size\") or m.get(\"estimated_size\") or 0) / 1e9))
for m in get(\"http://127.0.0.1:11434/api/ps\").get(\"models\", []): print(\"M|%s|%.1f|%s\" % (m[\"name\"], (m.get(\"size_vram\") or m.get(\"size\", 0)) / 1e9, (m.get(\"details\") or {}).get(\"format\", \"\")))" 2>/dev/null)
models=$(printf "%s\n" "$ml" | awk -F"|" "NF>1{print \$2}" | sort -u | paste -sd, -)
vms=$(command -v limactl >/dev/null && limactl list --format "{{.Name}}:{{.Status}}" 2>/dev/null | paste -sd, -)
echo "H|$cpu|$used/${tot}G|${models:--}|${vms:-}|${gpu:+$gpu%}"
[ -n "$ml" ] && printf "%s\n" "$ml"
if command -v tmux >/dev/null; then
  now=$(date +%s)
  tmux list-sessions -F "#{session_name}|#{session_activity}|#{session_attached}|#{pane_title}" 2>/dev/null | grep "^gwm-" |
  while IFS="|" read -r n act att title; do echo "S|${n#gwm-}|$((now-act))|$att|$(echo "$title" | tr "|" "/")"; done
fi
if [ "$(uname)" = Darwin ]; then
  who | sed -n "s/.*(\(.*\))\$/\1/p" | sed "s/%.*//; s/^fe80:[0-9a-f]*::/fe80::/" | sort | uniq -c | while read -r k ip; do echo "T|$ip|$k"; done
  lsof -nP -iTCP:22 -sTCP:ESTABLISHED 2>/dev/null | awk "NR>1 && \$1 ~ /sshd/ {print \$9}" | sort -u | sed "s/.*->//" |
    sed "s/:[0-9]*\$//; s/^\[//; s/\]\$//; s/^fe80:[0-9a-f]*::/fe80::/" | sort | uniq -c | while read -r k ip; do echo "C|$ip|$k"; done
  ps -axo tty=,command= | awk "/\/usr\/bin\/login -f .* -h [0-9a-f.:]+ / {for(i=1;i<=NF;i++) if(\$i==\"-h\") print \$1, \$(i+1)}" |
    while read -r tt ip; do echo "C|$ip|1"; [ "$tt" != "??" ] && echo "T|$ip|1"; done
  echo "I|$( { ifconfig 2>/dev/null | awk "/inet6? /{print \$2}"; tailscale ip 2>/dev/null; } | sed "s/%.*//; s/^fe80:[0-9a-f]*::/fe80::/" | grep -vE "^(127\.|::1\$|fe80::1\$)" | sort -u | paste -sd, -)"
else
  who 2>/dev/null | sed -n "s/.*(\(.*\))\$/\1/p" | sed "s/%.*//" | sort | uniq -c | while read -r k ip; do echo "T|$ip|$k"; echo "C|$ip|$k"; done
  echo "I|$( { hostname -I 2>/dev/null | tr " " "\n"; tailscale ip 2>/dev/null; } | grep -vE "^(127\.|::1\$|fe80:|\$)" | sort -u | paste -sd, -)"
fi
# this machine own sessions.conf, so a machine that missed a new session can pick it up: L|name|host|engine|account|folder
[ -f ~/.config/go-with-me/sessions.conf ] && awk -F"|" "/^[[:space:]]*#/||NF<4{next} {o=\"L\"; for(i=1;i<=5;i++){v=\$i; gsub(/^[[:space:]]+|[[:space:]]+\$/,\"\",v); o=o \"|\" v} print o}" ~/.config/go-with-me/sessions.conf
'
demo_probe() {  # fake but lively data for `gwm demo`
  local t=$(( $(date +%s) / 5 )) r=$RANDOM
  echo "studio|H|$((18 + r % 15))%|31/64G|inkling-2-mini,cam-r3-2b|sandbox:Running|$((40 + r % 30))%"
  echo "studio|M|inkling-2-mini:latest|25.3"; echo "studio|M|cam-r3-2b:latest|1.1"
  echo "studio|S|landing-page|$(( t % 3 == 0 ? 40 : 2 ))|1|✳ Building hero section"
  echo "studio|S|local-refactor|840|0|✳ Refactor CLI arg parsing"
  echo "studio|T|10.0.0.3|1"; echo "studio|C|10.0.0.3|1"
  echo "office-1|H|$((64 + r % 20))%|88/128G|qwen3.8-27b,flux-dev|-|$((80 + r % 15))%"
  echo "office-1|M|qwen3.8-27b:latest|17.2"; echo "office-1|M|flux-dev:latest|23.8"
  echo "office-1|S|api-tests|$(( t % 2 == 0 ? 3 : 95 ))|0|✳ Fixing flaky API tests"
  echo "macbook|H|$((6 + r % 6))%|14/24G|-|-|$((3 + r % 5))%"
  echo "sandbox|H|$((3 + r % 4))%|2/8G|-|-"
  echo "sandbox|S|load-test|1500|0|✳ Load test finished"
}
TS_CHECK="Tailscale SSH requires an additional check"
probe_all() {  # → "host|H|..." and "host|S|..." lines, all hosts in parallel
  [ -n "${GWM_DEMO:-}" ] && { demo_probe; return; }
  local tmp; tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' INT TERM
  while IFS=$'\t' read -r h _; do
    ( o="$tmp/.$h.out" e="$tmp/.$h.err"
      GWM_SSH_LOGLEVEL=INFO run_script "$h" "$PROBE" >"$o" 2>"$e" & p=$!
      for _ in $(seq 1 60); do kill -0 "$p" 2>/dev/null || break; grep -q "$TS_CHECK" "$e" 2>/dev/null && break; sleep 0.25; done
      kill -0 "$p" 2>/dev/null && { pkill -P "$p" 2>/dev/null; kill "$p" 2>/dev/null; }
      wait "$p" 2>/dev/null
      out="$(grep -E '^[HSTCIML]\|' "$o")"
      [ -z "$out" ] && grep -q "$TS_CHECK" "$e" 2>/dev/null && out="A|$(grep -o 'https://login.tailscale.com/[^[:space:]]*' "$e" | head -1)"
      [ -n "$out" ] || out="DOWN"; printf '%s\n' "$out" | sed "s/^/$h|/" > "$tmp/$h"; rm -f "$o" "$e" ) &
  done < <(hosts)
  wait; adopt_sessions "$tmp"; cat "$tmp"/* 2>/dev/null | grep -v '^[^|]*|L|'; rm -rf "$tmp"
  trap - INT TERM
}
adopt_sessions() {  # adopt_sessions <probe dir>: add sessions other machines host that are missing here
  [ -f "$SESSIONS" ] || return 0
  local ph n h e a f me now lines=""
  me="$(self_name)"; now="$(date +%s)"
  while IFS='|' read -r ph _ n h e a f; do
    [ "$ph" = "$h" ] && [ "$h" != "$me" ] || continue
    [ -n "$f" ] || f="~"
    [[ "$n" =~ $NAME_RE ]] && [ "$n" != coordinator ] && [[ "$h" =~ $NAME_RE ]] && [[ "$e" =~ $NAME_RE ]] \
      && { [ "$a" = - ] || [[ "$a" =~ $NAME_RE ]]; } && [[ "$f" =~ $FOLDER_RE ]] || continue
    # skip if explicitly closed locally (tombstone still valid)
    [ -f "$CLOSED_FILE" ] && awk -F'|' -v n="$n" -v cut="$((now - 2592000))" '$1==n && $2+0>=cut{ok=1; exit} END{exit !ok}' "$CLOSED_FILE" && continue
    hfield "$h" 1 >/dev/null 2>&1 || continue
    GWM_QUIET=1 sfield "$n" 1 >/dev/null 2>&1 && continue
    lines+="$(printf '%s | %s | %s | %s | %s\n' "$n" "$h" "$e" "$a" "$f")"$'\n'
  done < <(cat "$1"/* 2>/dev/null | grep '^[^|]*|L|')
  [ -n "$lines" ] || return 0
  cfg_lock || return 0
  while IFS= read -r ln; do
    [ -n "$ln" ] || continue
    n="${ln%% | *}"
    GWM_QUIET=1 sfield "$n" 1 >/dev/null 2>&1 || printf '%s\n' "$ln" >> "$SESSIONS"
  done <<<"$lines"
  cfg_unlock
}
ip_map() {  # "ip<TAB>hostname" for every SSH host, cached 60s (invalidated when hosts.conf changes)
  [ -n "${GWM_DEMO:-}" ] && { printf '10.0.0.3\tmacbook\n'; return; }
  local cache="$CFG/.ip-cache" now; now="$(date +%s)"
  if [ -f "$cache" ] && [ $((now - $(mtime "$cache"))) -lt 60 ] && [ "$(mtime "$cache")" -ge "$(mtime "$HOSTS")" ]; then
    cat "$cache"; return
  fi
  local tmp; tmp="$(mktemp "$CFG/.ip-cache.XXXXXX" 2>/dev/null)"
  while IFS=$'\t' read -r h t _; do
    case "$t" in vm:*) continue;; esac
    local hn="${t#*@}"
    if [[ "$hn" =~ ^[0-9.]+$ ]]; then printf '%s\t%s\n' "$hn" "$h"
    else dscacheutil -q host -a name "$hn" 2>/dev/null | awk -v h="$h" '/ip_address|ipv6_address/{ip=$2; sub(/^fe80:[0-9a-f]*::/,"fe80::",ip); if(ip!="::1" && ip!="127.0.0.1" && ip!="fe80::1") printf "%s\t%s\n", ip, h}'; fi
  done < <(hosts) | if [ -n "$tmp" ]; then tee "$tmp"; mv "$tmp" "$cache" 2>/dev/null; else cat; fi
}
used_by() {  # used_by <host> <probe data> <ip map>  → "macbook: 2 tabs, 1 agent" (single awk pass)
  awk -v h="$1" -v me="$(self_name)" '
    FNR==NR {
      split($0, p, "|")
      if (p[2]=="I" && p[3]!="") {
        m = split(p[3], ips, ",")
        for (i=1; i<=m; i++) if (ips[i]!="" && !(ips[i] in ip2h)) ip2h[ips[i]] = p[1]
      } else if (p[1]==h && p[2]=="C") {
        if (!(p[3] in conns)) { co[++nc] = p[3] }
        conns[p[3]] += p[4]
      } else if (p[1]==h && p[2]=="T") {
        tabs[p[3]] += p[4]
      }
      next
    }
    { split($0, m, "\t"); if (m[1]!="" && !(m[1] in ip2h)) ip2h[m[1]] = m[2] }
    END {
      for (i=1; i<=nc; i++) {
        ip = co[i]
        who = (ip in ip2h && ip2h[ip]!="") ? ip2h[ip] : ip
        tc = tabs[ip] + 0
        ac = conns[ip] - tc
        if (who == me && h != me) ac -= 1
        if (ac < 0) ac = 0
        if (!(who in seen)) { seen[who]=1; ord[++nw]=who }
        T[who] += tc; A[who] += ac
      }
      for (i=1; i<=nw; i++) {
        w = ord[i]; s = ""
        if (T[w]>0) s = T[w] " tab" (T[w]>1?"s":"")
        if (A[w]>0) s = s (s?", ":"") A[w] " agent" (A[w]>1?"s":"")
        if (s!="") out = out (out?"; ":"") w ": " s
      }
      print out
    }' <(printf '%s\n' "$2") <(printf '%s\n' "$3")
}
probe_cached() {  # probe_cached <max-age-seconds>: one SSH sweep shared by the board and every sidebar
  local cache="$CFG/.probe-cache" lock="$CFG/.probe-lock" age=999 max="${1:-5}"
  [ -f "$cache" ] && age=$(( $(date +%s) - $(mtime "$cache") ))
  [ -d "$lock" ] && [ $(( $(date +%s) - $(mtime "$lock") )) -gt 60 ] && rmdir "$lock" 2>/dev/null
  if [ "$age" -gt "$max" ] && mkdir "$lock" 2>/dev/null; then
    local tmp; tmp="$(mktemp "$CFG/.probe-cache.XXXXXX")"
    trap 'rm -f "$tmp"; rmdir "$lock" 2>/dev/null' INT TERM
    ( probe_all ) > "$tmp" && mv "$tmp" "$cache" || rm -f "$tmp"
    rmdir "$lock" 2>/dev/null
    trap - INT TERM
  elif [ ! -f "$cache" ]; then
    local i=0; while [ ! -f "$cache" ] && [ -d "$lock" ] && [ $i -lt 40 ]; do sleep 0.1; i=$((i+1)); done
    [ -f "$cache" ] || { probe_all; return; }
  fi
  cat "$cache"
}
cmd_data() {  # machine-readable state for the sidebar
  local data map; data="$(probe_cached 5)"; map="$(ip_map)"
  printf '#SELF\t%s\n' "$(self_name)"; printf '#COORD\t%s\n' "$(coord_host)"
  hosts | sed 's/^/#HOST	/'; sessions | sed 's/^/#SESS	/'
  while IFS=$'\t' read -r h _; do printf '#USED\t%s\t%s\n' "$h" "$(used_by "$h" "$data" "$map")"; done < <(hosts)
  printf '%s\n' "$data"
}
probe_line() { awk -F'|' -v h="$1" -v k="$2" -v n="${3:-}" '$1==h && $2==k && (n=="" || $3==n){print; exit}' <<<"$4"; }
print_table() {
  local data cols map; data="$(probe_cached "${GWM_MAXAGE:-0}")"; map="$(ip_map)"; cols=$(tput cols 2>/dev/null || echo 140)
  printf "$(c '1;38;5;214')%-12s %-13s %5s %5s %-9s %-16s %-26s %s$(c 0)\n" HOST STATUS CPU GPU RAM "VMs" "USED BY (other devices)" "MODELS LOADED"
  while IFS=$'\t' read -r h t role; do
    line="$(probe_line "$h" H "" "$data")"
    if [ -n "$line" ]; then
      IFS='|' read -r _ _ cpu ram models vms gpu <<<"$line"
      models="$(awk -F'|' -v h="$h" '$1==h && $2=="M"{n=$3; sub(/:latest$/,"",n); name[++k]=n; sz[k]=$4; fmt[k]=($5=="safetensors"?"mlx":$5); c[n]++}
        END{for(i=1;i<=k;i++) printf "%s%s%s (%s GB)", (i>1?", ":""), name[i], (c[name[i]]>1 && fmt[i]!="" ? " ·" fmt[i] : ""), sz[i]}' <<<"$data")"
      st="● on"; is_local "$h" && st="● on (here)"; case "$t" in vm:*) st="● vm";; esac
      ub="$(used_by "$h" "$data" "$map")"
      printf "%-12s $(c 32)%-15s$(c 0) %5s %5s %-9s %-16.16s $(c 35)%-26.26s$(c 0) %s\n" "$h" "$st" "$cpu" "${gpu:--}" "$ram" "${vms:--}" "${ub:-—}" "${models:--}"
    elif line="$(probe_line "$h" A "" "$data")" && [ -n "$line" ]; then
      printf "%-12s $(c 33)%-15s$(c 0) %s\n" "$h" "◐ approval" "Tailscale SSH wants this login re-approved → ssh ${t} once, or open: $(cut -d'|' -f3 <<<"$line")"
    else
      printf "%-12s $(c 31)%-15s$(c 0) %s\n" "$h" "○ offline" "asleep / off / not set up → gwm doctor"
    fi
  done < <(hosts)
  echo
  printf "$(c '1;38;5;110')%-14s %-10s %-9s %-10s %-12s %s$(c 0)\n" SESSION HOST ENGINE ACCOUNT STATE "CURRENT TASK"
  while IFS=$'\t' read -r n h e a f; do
    line="$(probe_line "$h" S "$n" "$data")"
    if [ -n "$line" ]; then
      IFS='|' read -r _ _ _ idle att title <<<"$line"
      if [ "$idle" -lt 8 ]; then st="working"; elif [ "$idle" -lt 3600 ]; then st="idle $((idle/60))m"; else st="idle $((idle/3600))h"; fi
      [ "$att" -gt 0 ] && st="$st *"
      col=32; [ "${st%% *}" = working ] && col=33
      printf "%-14s %-10s %-9s %-10s $(c $col)%-12s$(c 0) %s\n" "$n" "$h" "$e" "$a" "$st" "$title" | cut -c1-$((cols+12))
    elif [ -n "$(probe_line "$h" H "" "$data")" ]; then
      printf "%-14s %-10s %-9s %-10s $(c 2)%-12s %s$(c 0)\n" "$n" "$h" "$e" "$a" "not running" "→ gwm open $n"
    elif [ -n "$(probe_line "$h" A "" "$data")" ]; then
      printf "%-14s %-10s %-9s %-10s $(c 33)%-12s$(c 0)\n" "$n" "$h" "$e" "$a" "needs approval"
    else
      printf "%-14s %-10s %-9s %-10s $(c 31)%-12s$(c 0)\n" "$n" "$h" "$e" "$a" "host offline"
    fi
  done < <(sessions)
}
cmd_board() {
  while true; do
    out="$(GWM_MAXAGE=4 print_table 2>&1)"
    [ "${ZELLIJ_SESSION_NAME:-}" = "$HUBNAME" ] && renumber_tabs   # also fixes numbers after tabs are moved/closed by hand
    clear
    printf "$(c 2)go-with-me · %s · refreshes every 5s · * = someone attached$(c 0)\n\n%s\n" "$(date +%H:%M:%S)" "$out"
    sleep 5
  done
}

# ---------- sessions ----------
start_cmd() {  # start_cmd <name> [takeover]: the command that creates-or-attaches session <name> on its host
  local n="$1" take="${2:-}" e a f env="" prog
  e="$(sfield "$n" 3)"; a="$(sfield "$n" 4)"; f="$(sfield "$n" 5)"; [ -n "$f" ] || f="~"
  [ -n "$a" ] && [ "$a" != default ] && [ "$a" != - ] && env="-e CLAUDE_CONFIG_DIR=$ACCT_DIR/$a"
  # Every session is just a terminal — nothing is launched for you. The engine only sets a hint (and the account).
  local h; h="$(sfield "$n" 2)"
  case "$e" in
    claude)   prog="printf \"\\033[2mgo-with-me · $n on $h · for Claude Code (account: ${a:-default}) — type \\033[0;1mclaude\\033[0;2m when you want it\\033[0m\\n\\n\"; unset $CLAUDE_MARKERS; exec \$SHELL -l" ;;
    opencode) prog="printf \"\\033[2mgo-with-me · $n on $h · for opencode (local models) — type \\033[0;1mopencode\\033[0;2m when you want it\\033[0m\\n\\n\"; unset $CLAUDE_MARKERS; exec \$SHELL -l" ;;
    shell)    prog="unset $CLAUDE_MARKERS; exec \$SHELL -l" ;;
    *) [[ "$e" =~ ^[A-Za-z0-9._-]+$ ]] || die "session '$n': engine '$e' must be a program name"
       prog="printf \"\\033[2mgo-with-me · $n on $h · for $e — type \\033[0;1m$e\\033[0;2m when you want it\\033[0m\\n\\n\"; unset $CLAUDE_MARKERS; exec \$SHELL -l" ;;
  esac
  # tmux on the host is only a keep-alive layer: no status bar, no prefix key, so you never have to deal with it
  local quiet="\\; set-option -t '=$PFX$n' status off \\; set-option -t '=$PFX$n' prefix None \\; set-option -t '=$PFX$n' prefix2 None \\; set-option -s escape-time 10"
  local qf; qf="$(qfolder "$f")"
  [ -n "${START_PROG:-}" ] && prog="$START_PROG"
  local d=""; [ -n "$take" ] && d="-D"; [ -n "${START_DETACHED:-}" ] && d="-d"
  local scrub="for v in $CLAUDE_MARKERS; do tmux set-environment -g -u \$v 2>/dev/null; done;"   # -D: the other screen lets go (only when you ask for it)
  [ -n "$env" ] && echo "$scrub mkdir -p $ACCT_DIR/$a; cd $qf 2>/dev/null || cd; tmux new-session $( [ -n "${START_DETACHED:-}" ] || echo -A ) $d -s $PFX$n $env '$prog' $quiet" \
                || echo "$scrub cd $qf 2>/dev/null || cd; tmux new-session $( [ -n "${START_DETACHED:-}" ] || echo -A ) $d -s $PFX$n '$prog' $quiet"
}
# attach_loop <label> <host> <tmux-session> <start-cmd> <takeover-start-cmd>
# Never steals a session from another screen by itself: if it's open elsewhere, wait (and connect when it's free),
# or let the user choose to bring it here (Enter) or watch it read-only (w).
attach_loop() {
  local label="$1" h="$2" ts="$3" start="$4" take="$5" busy k
  while true; do
    busy="$(run_script "$h" "tmux display -p -t '=$ts:' '#{session_attached}' 2>/dev/null" 2>/dev/null | tail -1)"
    if [ "${busy:-0}" -gt 0 ] 2>/dev/null; then
      clear
      echo "$(c 1)$label$(c 0) is open on another screen right now (it runs on $h)."
      echo
      echo "  $(c 1)Enter$(c 0)  bring it here — the other screen lets go"
      echo "  $(c 1)w$(c 0)      watch it here, read-only, without taking it"
      echo "  $(c 2)…or just wait: this tab connects by itself when the other screen lets go$(c 0)"
      k=""; IFS= read -rsn1 -t 5 k; local rc=$?
      if [ $rc -gt 128 ]; then continue; fi          # timed out: check again
      case "$k" in
        "") run_tty "$h" "$take" ;;
        w|W) clear; echo "Watching $label (read-only). Leave with ⌥X or by closing this tab."; run_tty "$h" "tmux attach-session -r -t '=$ts'" ;;
        *) continue ;;
      esac
    else
      clear; echo "Connecting to $label on $h …"
      run_tty "$h" "$start"
    fi
    echo; echo "$(c 33)Disconnected from $label.$(c 0) It keeps running on $h."
    printf "Press Enter to reconnect: "; read -r _ || exit 0
  done
}
cmd_attach() {
  local n="$1" h; need_session "$n"; h="$(sfield "$n" 2)"
  [ -n "${GWM_DEMO:-}" ] && exec bash "$DIR/demo/agent.sh" "$n"
  attach_loop "$n" "$h" "$PFX$n" "$(start_cmd "$n")" "$(start_cmd "$n" take)"
}

# ---------- the coordinator: one shared session, on one machine ----------
coord_host() {  # the machine the coordinator lives on: ~/.config/go-with-me/coordinator, else the first machine listed
  local h=""; [ -f "$CFG/coordinator" ] && h="$(tr -d '[:space:]' < "$CFG/coordinator")"
  [ -n "$h" ] && hfield "$h" 1 >/dev/null 2>&1 && { echo "$h"; return; }
  hosts | head -1 | cut -f1
}
cmd_attach_coordinator() {  # what every hub's coordinator tab runs: attach to the one shared coordinator session
  local h; h="$(coord_host)"; [ -n "$h" ] || die "no machines configured"
  [ -n "${GWM_DEMO:-}" ] && exec bash "$DIR/demo/coordinator.sh"
  local start="d=\$(dirname \"\$(readlink \$HOME/.local/bin/gwm 2>/dev/null || echo \$HOME/go-with-me/go-with-me)\"); cd \"\$d/coordinator\" 2>/dev/null || cd; tmux new-session -A TAKE -s ${PFX}coordinator \"\$d/go-with-me _shell coordinator\" \\; set-option -t '=${PFX}coordinator' status off \\; set-option -t '=${PFX}coordinator' prefix None \\; set-option -t '=${PFX}coordinator' prefix2 None"
  attach_loop "the coordinator" "$h" "${PFX}coordinator" "${start/ TAKE / }" "${start/ TAKE / -D }"
}
cmd_coordinator() {  # gwm coordinator [machine]: show or set where the shared coordinator lives
  if [ -n "${1:-}" ]; then need_host "$1"; echo "$1" > "$CFG/coordinator"
    while IFS=$'\t' read -r h t _; do   # every machine must agree, or you'd get two coordinators
      is_local "$h" && continue; case "$t" in vm:*) continue;; esac
      ( run_script "$h" "mkdir -p ~/.config/go-with-me && echo $1 > ~/.config/go-with-me/coordinator" >/dev/null 2>&1 \
          || echo "$(c 33)•$(c 0) couldn't tell '$h' (offline?) — run there: gwm coordinator $1" ) &
    done < <(hosts)
    wait
    echo "$(c 32)✓$(c 0) The coordinator now lives on '$1' on every machine (open hubs pick it up when restarted)."
  else echo "The coordinator lives on '$(coord_host)'. Change with: gwm coordinator <machine>"; fi
}

# ---------- hub (Zellij) ----------
HUBNAME="${GWM_HUB:-gwm}"
hub_running() { zellij list-sessions -n 2>/dev/null | grep -E "^$HUBNAME " | grep -vq EXITED; }
tab_layout() {  # tab_layout <session>  → KDL for one session tab
  local n="$1" h e a; h="$(sfield "$n" 2)"; e="$(sfield "$n" 3)"; a="$(sfield "$n" 4)"
  local label="$n · $e on $h"; [ "$e" = claude ] && label="$label · account: $a"
  printf '  tab name="%s" {\n    pane name="%s" focus=true command="%s" { args "attach" "%s"; }\n  }\n' "$n" "$label" "$ME" "$n"
}
bars() {  # every tab: the go-with-me sidebar on the left (the only navigation), the tab's content on the right
  printf '  default_tab_template {\n    pane split_direction="vertical" {\n'
  printf '      pane size=34 borderless=true command="%s" { args "sidebar"; }\n      children\n    }\n  }\n' "$ME"
}
running_sessions() {  # names of configured sessions that are running right now on their machine
  local data; data="$(probe_all)"
  while IFS=$'\t' read -r n h _; do [ -n "$(probe_line "$h" S "$n" "$data")" ] && echo "$n"; done < <(sessions)
}
write_layout() {  # only sessions that are already running get a tab; others are opened with `gwm open <name>`
  local i=1 n
  { echo "layout {"; bars
    printf '  tab name="1 overview" focus=true {\n'
    if [ -n "${GWM_DEMO:-}" ]; then printf '    pane focus=true command="bash" { args "%s"; }\n  }\n' "$DIR/demo/coordinator.sh"
    else printf '    pane focus=true command="%s" { args "attach-coordinator"; }\n  }\n' "$ME"; fi
    for n in $(running_sessions); do i=$((i+1)); tab_layout "$n" | sed "1s/tab name=\"$n\"/tab name=\"$i $n\"/"; done
    echo "}"; } > "$CFG/hub-layout.kdl"
}
cmd_open() {
  command -v zellij >/dev/null || die "zellij not installed (brew install zellij)"
  [ -n "$(self_name)" ] || die "run 'gwm init <this-host-name>' first"
  [ "${ZELLIJ_SESSION_NAME:-}" = "$HUBNAME" ] && die "you're already inside the go-with-me hub"
  scrub_env
  export ZELLIJ_NESTED_MAX_UNACKED_ANNOUNCES=0
  if hub_running; then exec zellij attach "$HUBNAME"; fi
  zellij delete-session "$HUBNAME" >/dev/null 2>&1
  echo "Checking which sessions are running…"; write_layout
  exec zellij --config "$DIR/hub.zellij.kdl" --session "$HUBNAME" --new-session-with-layout "$CFG/hub-layout.kdl"
}
hub_tabs() {  # "id<TAB>position<TAB>name-without-number<TAB>raw-name" for every hub tab
  zellij --session "$HUBNAME" action list-tabs 2>/dev/null |
    awk 'NR>1{id=$1; pos=$2; $1=$2=""; sub(/^[[:space:]]+/,""); raw=$0; sub(/^[0-9]+ /,""); printf "%s\t%s\t%s\t%s\n", id, pos, $0, raw}'
}
renumber_tabs() {  # keep "N name" in sync with tab positions in a single list-tabs call
  hub_running || return 0
  hub_tabs | while IFS=$'\t' read -r id pos name raw; do
    [ "$raw" = "$((pos+1)) $name" ] || zellij --session "$HUBNAME" action rename-tab-by-id "$id" "$((pos+1)) $name" >/dev/null 2>&1
  done
}
open_tab() {  # open (or jump to) the hub tab for <session>
  hub_running || return 1
  local id; id="$(hub_tabs | awk -F'\t' -v n="$1" '$3==n{print $1; exit}')"
  if [ -n "$id" ]; then zellij --session "$HUBNAME" action go-to-tab-by-id "$id" >/dev/null 2>&1; return 0; fi
  local tmp; tmp="$(mktemp "$CFG/tab-$1.XXXXXX.kdl")"
  { echo "layout {"; bars; tab_layout "$1" | sed '1s/^  tab [^{]*{/  tab {/'; echo "}"; } > "$tmp"
  zellij --session "$HUBNAME" action new-tab --name "$1" --layout "$tmp" >/dev/null 2>&1; rm -f "$tmp"
  renumber_tabs
}
close_tab() {  # close the hub tab for <session>, if open
  hub_running || return 0
  local id; id="$(hub_tabs | awk -F'\t' -v n="$1" '$3==n{print $1; exit}')"
  [ -n "$id" ] && zellij --session "$HUBNAME" action close-tab-by-id "$id" >/dev/null 2>&1
  renumber_tabs
}
sync_session() {  # sync_session add <name> <line> | remove <name>: keep every machine's sessions.conf in step (parallel)
  local op="$1" n="$2" line="${3:-}" enc h t
  enc="$(printf '%s\n' "$line" | base64 | tr -d '\n')"
  while IFS=$'\t' read -r h t _; do
    is_local "$h" && continue; case "$t" in vm:*) continue;; esac
    ( if [ "$op" = add ]; then
        run_script "$h" "f=~/.config/go-with-me/sessions.conf; [ -f \$f ] || exit 0; awk -F'|' -v n='$n' '{v=\$1; gsub(/^[[:space:]]+|[[:space:]]+\$/,\"\",v)} v==n{f=1} END{exit !f}' \$f || printf %s $enc | base64 -d >> \$f" >/dev/null 2>&1
      else
        run_script "$h" "f=~/.config/go-with-me/sessions.conf; [ -f \$f ] || exit 0; t=\$(mktemp \"\$f.XXXXXX\") && awk -F'|' -v n='$n' '{v=\$1; gsub(/^[[:space:]]+|[[:space:]]+\$/,\"\",v)} v!=n' \$f > \"\$t\" && mv \"\$t\" \$f" >/dev/null 2>&1
      fi || echo "$(c 33)•$(c 0) couldn't update '$h' (offline?) — new sessions reach it automatically once it's back" ) &
  done < <(hosts)
  wait
}
start_detached() {  # start_detached <name> <program…>: start a saved session in the background running a program
  local n="$1" h; h="$(sfield "$n" 2)"
  START_PROG="unset $CLAUDE_MARKERS; $2; exec \$SHELL -l" START_DETACHED=1 run_script "$h" "$(START_PROG="unset $CLAUDE_MARKERS; $2; exec \$SHELL -l" START_DETACHED=1 start_cmd "$n")" >/dev/null 2>&1
  run_script "$h" "tmux has-session -t '=$PFX$n' 2>/dev/null && echo GWM_UP" 2>/dev/null | grep -q GWM_UP
}
cmd_spawn() {  # gwm spawn <name> --on <machine> [--engine e] [--account a] [--folder f] [--prompt "first task"]
  local n="" h="" e="claude" a="default" f="~" prompt=""
  while [ $# -gt 0 ]; do case "$1" in
    --on) h="$2"; shift 2;; --engine) e="$2"; shift 2;; --account) a="$2"; shift 2;; --folder) f="$2"; shift 2;;
    --prompt) prompt="$2"; shift 2;; *) n="$1"; shift;; esac; done
  [ -n "$n" ] && [ -n "$h" ] || die "usage: gwm spawn <name> --on <machine> [--engine claude] [--account a] [--folder f] [--prompt \"task\"]"
  [ "$e" = claude ] || a="-"
  ensure_host "$h"; h="$ENSURED"
  sfield "$n" 1 >/dev/null 2>&1 || GWM_NO_TAB=1 cmd_new "$n" --on "$h" --engine "$e" --account "$a" --folder "$f" </dev/null >/dev/null || exit 1
  local program="$e"
  [ "$e" = shell ] && program="true"
  [ -n "$prompt" ] && [ "$e" = claude ] && program="claude \"\$(printf %s $(b64 "$prompt") | base64 -d)\""
  start_detached "$n" "$program" || die "couldn't start '$n' on $h"
  if [ -n "$prompt" ] && [ "$e" != claude ] && [ "$e" != shell ]; then sleep 4; cmd_send "$n" "$prompt" >/dev/null; fi
  open_tab "$n" || true
  echo "$(c 32)✓$(c 0) Spawned '$n' on $h — $e is running$([ -n "$prompt" ] && echo " with its first task")."
}
cmd_resume() {  # gwm resume <name>: bring back a closed session, reopening its Claude conversation
  local n="${1:-}"; [ -n "$n" ] || die "usage: gwm resume <session>   (see: gwm archive)"
  sfield "$n" 1 >/dev/null 2>&1 && die "'$n' is already a saved session — open it with: gwm open $n"
  local rec; rec="$(archive_records | awk -F'\t' -v n="$n" '$1==n' | sort -t$'\t' -k7 | tail -1)"
  [ -n "$rec" ] || die "no closed session called '$n' (see: gwm archive)"
  local h e a f sid; IFS=$'\037' read -r _ h e a f _ _ sid _ <<<"$(tr '\t' '\037' <<<"$rec")"
  need_host "$h"; [[ "$sid" =~ ^[A-Za-z0-9-]*$ ]] || die "bad conversation id in the archive record"
  GWM_NO_TAB=1 cmd_new "$n" --on "$h" --engine "$e" --account "${a:-default}" --folder "${f:-~}" </dev/null >/dev/null || exit 1
  if [ "$e" = claude ] && [ -n "$sid" ]; then start_detached "$n" "claude --resume $sid" || die "couldn't start '$n' on $h"
  else start_detached "$n" "true" || die "couldn't start '$n' on $h"; fi
  open_tab "$n" || true
  echo "$(c 32)✓$(c 0) Resumed '$n' on $h$([ -n "$sid" ] && echo " — Claude reopened its conversation")."
}
cmd_pick() {  # ⌥O: open a saved session, or create one with a new name
  echo "$(c 1)Open a session$(c 0)"; echo
  sessions | awk -F'\t' '{printf "  %-16s %s on %s\n", $1, $3, $2}'; echo
  local n; n="$(ask "Name to open (or a new name to create one)" "")"; [ -n "$n" ] || exit 0
  if sfield "$n" 1 >/dev/null 2>&1; then cmd_open_session "$n"; else cmd_new "$n"; fi
}
cmd_open_session() {
  local n="$1"
  if ! sfield "$n" 1 >/dev/null 2>&1; then
    echo "There's no session called '$n' yet. Saved sessions: $(sessions | cut -f1 | paste -sd' ' - | sed 's/ /, /g')"
    [ -t 0 ] || die "create it with: gwm new $n --on <machine>"
    case "$(ask "Create '$n' now? (y/n)" y)" in y|Y|yes) cmd_new "$n" || exit 1;; *) exit 0;; esac
    return
  fi
  open_tab "$n" && echo "$(c 32)✓$(c 0) '$n' is open in the hub." || { echo "The hub isn't open — starting '$n' in this terminal instead."; cmd_attach "$n"; }
}
# ---------- your tailnet: start sessions on any machine on it ----------
ts_peers() {  # "dns<TAB>name<TAB>os<TAB>online|offline<TAB>ip" for every other machine on your tailnet
  [ -n "${GWM_DEMO:-}" ] && return 0
  tailscale status --json 2>/dev/null | python3 -c '
import sys, json, re
d = json.load(sys.stdin)
for p in (d.get("Peer") or {}).values():
    dns = p.get("DNSName", "").rstrip(".")
    if not dns: continue
    name = re.sub(r"[^a-z0-9-]", "", (p.get("HostName") or dns.split(".")[0]).lower())[:24] or dns.split(".")[0]
    print("\t".join([dns, name, p.get("OS") or "?", "online" if p.get("Online") else "offline", (p.get("TailscaleIPs") or [""])[0]]))' 2>/dev/null
}
peer_host() {  # peer_host <dns> <ip>: the go-with-me machine already saved for this tailnet peer, if any
  hosts | awk -F'\t' -v d="$1" -v i="$2" '{a=$2; sub(/^.*@/,"",a); sub(/\.$/,"",a); if (tolower(a)==tolower(d) || a==i) {print $1; exit}}'
}
find_peer() {  # find_peer <query>: the tailnet peer a name means (full DNS name, its first part, host name, or IP)
  local q; q="$(tr '[:upper:]' '[:lower:]' <<<"$1")"
  ts_peers | awk -F'\t' -v q="$q" '{d=tolower($1); l=d; sub(/\..*/,"",l)} d==q || l==q || $2==q || $5==q {print; exit}'
}
ENSURED=""
ensure_host() {  # ensure_host <machine | tailnet name> [user]: sets ENSURED to a saved machine — setting it up first if it's new
  local q="$1" user="${2:-}" p dns name os on ip known
  if hfield "$q" 1 >/dev/null 2>&1; then ENSURED="$q"; return 0; fi
  p="$(find_peer "$q")"
  [ -n "$p" ] || die "unknown machine '$q' — it's not in gwm hosts and not on your tailnet (see: gwm tailnet)"
  IFS=$'\t' read -r dns name os on ip <<<"$p"
  known="$(peer_host "$dns" "$ip")"
  if [ -n "$known" ]; then ENSURED="$known"; echo "$(c 2)('$q' is your machine '$known')$(c 0)" >&2; return 0; fi
  [ "$on" = online ] || die "'$q' ($dns) is on your tailnet but offline — wake it up and try again"
  hfield "$name" 1 >/dev/null 2>&1 && name="$name-2"
  echo "$(c 1)'$q' isn't set up for go-with-me yet$(c 0) — it's on your tailnet ($dns, $os). Setting it up (tmux, go-with-me, your config)…" >&2
  [ -n "$user" ] || user="$(ask "Your username on $dns" "$(whoami)")"
  ( cmd_add "$name" --address "$dns" --via tailscale --user "$user" --yes ) >&2 ||
    die "couldn't set up $dns (see above). Fix that, or run: gwm add --via tailscale --address $dns"
  hfield "$name" 1 >/dev/null 2>&1 || die "setting up $dns didn't finish"
  ENSURED="$name"
}
cmd_tailnet() {  # gwm tailnet: every machine on your tailnet, and whether go-with-me knows it
  ts_running || die "Tailscale isn't running on this Mac — run: gwm tailscale"
  local dns name os on ip k
  printf "$(c '1;38;5;214')%-40s %-8s %-8s %s$(c 0)\n" "TAILNET MACHINE" OS STATUS "GO-WITH-ME"
  ts_peers | sort | while IFS=$'\t' read -r dns name os on ip; do
    k="$(peer_host "$dns" "$ip")"
    if [ -n "$k" ]; then printf "%-40s %-8s %-8s $(c 32)✓ %s$(c 0)\n" "$dns" "$os" "$on" "$k"
    else printf "%-40s %-8s %-8s $(c 2)not set up → gwm new --on %s$(c 0)\n" "$dns" "$os" "$on" "${dns%%.*}"; fi
  done
}
cmd_tailnet_data() {  # machine-readable, for apps: dns name os online ip saved-as
  local dns name os on ip
  ts_peers | while IFS=$'\t' read -r dns name os on ip; do printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$dns" "$name" "$os" "$on" "$ip" "$(peer_host "$dns" "$ip")"; done
}

ask() {  # ask "Question" default  → reply (or default when not interactive)
  local q="$1" d="$2" r; if [ -t 0 ]; then printf '%s%s: ' "$q" "${d:+ [$d]}" >&2; read -r r; fi; echo "${r:-$d}"; }
cmd_new() {
  local n="" h="" e="" a="" f="" u=""
  while [ $# -gt 0 ]; do case "$1" in
    --on) h="$2"; shift 2;; --engine) e="$2"; shift 2;; --account) a="$2"; shift 2;; --folder) f="$2"; shift 2;; --user) u="$2"; shift 2;;
    *) n="$1"; shift;; esac; done
  echo "$(c 1)New session$(c 0) — a new tab running on one of your machines"
  if [ -z "$h" ]; then
    echo "Machines: $(hosts | cut -f1 | paste -sd' ' - | sed 's/ /, /g')"
    local more; more="$(ts_peers | while IFS=$'\t' read -r dns _ _ on ip; do [ "$on" = online ] && [ -z "$(peer_host "$dns" "$ip")" ] && echo "${dns%%.*}"; done | paste -sd' ' - | sed 's/ /, /g')"
    [ -n "$more" ] && echo "Also on your tailnet (set up automatically if you pick one): $more"
    h="$(ask "Machine" "$(self_name)")"
  fi
  ensure_host "$h" "$u"; h="$ENSURED"
  [ -n "$e" ] || e="$(ask "Engine — claude, opencode, shell, or any coding CLI (kimi, codex, gemini…)" claude)"
  [[ "$e" =~ ^[A-Za-z0-9._-]+$ ]] || die "engine must be a program name like claude, opencode, kimi or shell"
  if [ "$e" != shell ] && ! has_cmd "$h" "$e"; then
    echo "$(c 33)•$(c 0) '$e' isn't installed on $h (or isn't on its PATH). The tab will still open — install it there, then type $e."
  fi
  if [ "$e" = claude ]; then [ -n "$a" ] || a="$(ask "Claude account — default, or a label like work" default)"; else a="-"; fi
  [ -n "$f" ] || f="$(ask "Start folder" "~")"
  [ -n "$n" ] || n="$(ask "Tab name" "$h-$e")"
  [[ "$n" =~ ^[A-Za-z0-9_-]+$ ]] || die "tab name: letters, digits, - and _ only"
  [ "$n" = coordinator ] && die "'coordinator' is reserved for the shared coordinator — pick another name"
  [[ "$f" =~ $FOLDER_RE ]] || die "folder: letters, digits, spaces and _ . / ~ - only"
  { [ "$a" = - ] || [[ "$a" =~ $NAME_RE ]]; } || die "account: letters, digits, _ . - only"
  sfield "$n" 1 >/dev/null 2>&1 && die "a session called '$n' already exists"
  local line locked=0; line="$(printf '%-14s| %-8s| %-9s| %-8s| %s' "$n" "$h" "$e" "$a" "$f")"
  clear_closed "$n"
  cfg_lock && locked=1
  printf '%s\n' "$line" >> "$SESSIONS"
  [ $locked -eq 1 ] && cfg_unlock
  sync_session add "$n" "$line"
  [ -n "${GWM_NO_TAB:-}" ] || open_tab "$n"
  echo "$(c 32)✓$(c 0) Added '$n' ($e on $h$([ "$e" = claude ] && echo ", account $a"))."
  hub_running && echo "  Its tab is open in the hub." || echo "  Open the hub with: gwm"
  [ "$e" = claude ] && [ "$a" != default ] && echo "  First time with account '$a' on $h? Sign in inside the tab, or: gwm login $a --on $h"
  return 0
}
cmd_close() {
  local n="" yes=""; for x in "$@"; do case "$x" in -y|--yes) yes=1;; *) n="$x";; esac; done
  [ -n "$n" ] || die "usage: gwm close <session> [--yes]"
  [[ "$n" =~ $NAME_RE ]] || die "unknown session '$n'"
  local h
  if sfield "$n" 1 >/dev/null 2>&1; then h="$(sfield "$n" 2)"
  else  # not saved anywhere, but maybe still running on one of the machines
    h="$(probe_cached 5 | awk -F'|' -v n="$n" '$2=="S" && $3==n {print $1; exit}')"
    [ -n "$h" ] || die "no session called '$n' is saved or running (gwm sessions · gwm status)"
  fi
  if [ -z "$yes" ]; then
    [ -t 0 ] || die "add --yes to confirm closing '$n'"
    printf "Close '%s'? It stops on %s and its tab goes away (its screen is saved to the archive first). [y/N] " "$n" "$h"; read -r r
    case "$r" in y|Y|yes) ;; *) echo "Cancelled."; return;; esac
  fi
  if sfield "$n" 1 >/dev/null 2>&1; then save_record "$h" "$n" "$(sfield "$n" 3)" "$(sfield "$n" 4)" "$(sfield "$n" 5)"
  else save_record "$h" "$n" claude default "~"; fi
  run_script "$h" "$(archive_cmd "$n"); tmux kill-session -t '=$PFX$n' 2>/dev/null" || true
  mark_closed "$n"
  filter_conf "$SESSIONS" 1 "$n"
  sync_session remove "$n"
  close_tab "$n"
  echo "$(c 32)✓$(c 0) Closed '$n' on $h."
}
cmd_peek() { local n="$1" k="${2:-40}"; need_session "$n"; is_uint "$k" || die "lines must be a positive number"
  run_script "$(sfield "$n" 2)" "tmux capture-pane -p -J -t '=$PFX$n:' -S -$k 2>/dev/null | awk 'NF{p=NR} {l[NR]=\$0} END{for(i=1;i<=p;i++) print l[i]}' || echo '(session $n is not running)'"; }
cmd_send() { local n="$1"; shift; need_session "$n"
  run_script "$(sfield "$n" 2)" "printf %s $(b64 "$*") | base64 -d | tmux load-buffer -b gwm - && tmux paste-buffer -d -b gwm -t '=$PFX$n:' && sleep 0.3 && tmux send-keys -t '=$PFX$n:' Enter && echo 'sent to $n'"; }
history_run() {  # history_run <host> <name> <lines|-1> <folder> <config-dir> [transcript]
  run_script "$1" "python3 -c \"\$(printf %s $(base64 < "$DIR/history.py" | tr -d '\n') | base64 -d)\" '$2' '$3' $(qfolder "$4") \"$5\" \"${6:-}\""
}
acct_dir() { if [ -n "${1:-}" ] && [ "$1" != default ] && [ "$1" != - ]; then echo "\$HOME/.config/go-with-me/accounts/$1"; else echo "\$HOME/.claude"; fi; }
cmd_history() {  # gwm history <session>|--all [lines]: the session's Claude conversation, from the machine it runs on
  local n="${1:-}" k="${2:-40}"; [ -n "$n" ] || die "usage: gwm history <session>|--all [lines]"
  is_uint "$k" || die "lines must be a positive number"
  if [ "$n" = --all ]; then
    local tmp i=0 x; tmp="$(mktemp -d)"
    while read -r x; do
      i=$((i+1)); ( cmd_history "$x" "$k" > "$tmp/$(printf '%04d' "$i")" 2>&1 ) &
    done < <(sessions | awk -F'\t' '$3=="claude"{print $1}')
    wait
    local first=1 f; for f in "$tmp"/*; do [ -f "$f" ] || continue; [ $first -eq 1 ] && first=0 || printf '\n────────\n'; cat "$f"; done
    rm -rf "$tmp"; return
  fi
  if ! sfield "$n" 1 >/dev/null 2>&1; then   # closed? use its archive record
    local rec; rec="$(archive_records | awk -F'\t' -v n="$n" '$1==n' | sort -t$'\t' -k7 | tail -1)"
    [ -n "$rec" ] || die "unknown session '$n' (gwm sessions · gwm archive)"
    local rh rt; rh="$(cut -f2 <<<"$rec")"; rt="$(cut -f9 <<<"$rec")"
    [ -n "$rt" ] || die "'$n' was closed without a Claude conversation"
    history_run "$rh" "$n" "$k" "~" "" "$rt"; return
  fi
  local a f; a="$(sfield "$n" 4)"; f="$(sfield "$n" 5)"; [ -n "$f" ] || f="~"
  history_run "$(sfield "$n" 2)" "$n" "$k" "$f" "$(acct_dir "$a")"
}
# archive_cmd <session>: save everything on the session's screen (and its scrollback) before it's stopped.
# Claude's own conversation files (~/.claude/projects) are never touched.
archive_cmd() { echo "mkdir -p ~/.config/go-with-me/archive && tmux capture-pane -p -J -S - -E - -t '=$PFX$1:' > ~/.config/go-with-me/archive/$1-\$(date +%Y%m%d-%H%M%S).txt 2>/dev/null && echo \"saved its screen to ~/.config/go-with-me/archive/\" ||  true"; }
# save_record <host> <name> <engine> <account> <folder>: remember which conversation a session had, so it can be resumed
save_record() {
  local h="$1" n="$2" e="$3" a="$4" f="$5" info rec
  info=""
  [ "$e" = claude ] && info="$(history_run "$h" "$n" -1 "$f" "$(acct_dir "$a")" 2>/dev/null | tail -1)"
  [ -n "$info" ] || info='{}'
  rec="$(INFO="$info" python3 -c 'import json,os,sys,time
i = json.loads(os.environ["INFO"] or "{}"); n,h,e,a,f = sys.argv[1:6]
print(json.dumps({"name": n, "host": h, "engine": e, "account": a, "folder": f, "closed": time.strftime("%Y-%m-%d %H:%M"),
  "title": i.get("title",""), "session_id": i.get("session_id",""), "transcript": i.get("transcript","")}))' "$n" "$h" "$e" "$a" "$f")"
  run_script "$h" "mkdir -p ~/.config/go-with-me/archive && printf %s $(b64 "$rec") | base64 -d > ~/.config/go-with-me/archive/$n-\$(date +%Y%m%d-%H%M%S).json" >/dev/null 2>&1
  [ -n "$(sed -n 's/.*"session_id": "\([^"]*\)".*/\1/p' <<<"$rec")" ] && echo "saved its Claude conversation for later — resume with: gwm resume $n"
}
archive_records() {  # every closed-session record on every machine (parallel)
  local tmp; tmp="$(mktemp -d)"
  while IFS=$'\t' read -r h t _; do
    case "$t" in vm:*) continue;; esac
    ( run_script "$h" 'for f in ~/.config/go-with-me/archive/*.json; do [ -f "$f" ] && { cat "$f"; echo; }; done; true' > "$tmp/$h" 2>/dev/null ) &
  done < <(hosts)
  wait
  cat "$tmp"/* 2>/dev/null | python3 -c 'import json,sys
for l in sys.stdin:
    l=l.strip()
    if not l: continue
    try: r=json.loads(l)
    except ValueError: continue
    print("\t".join(str(r.get(k,"")).replace("\t"," ") for k in ("name","host","engine","account","folder","title","closed","session_id","transcript")))'
  rm -rf "$tmp"
}
cmd_archive() {
  local recs; recs="$(archive_records)"
  [ -n "$recs" ] || { echo "No closed sessions yet."; return; }
  printf "$(c 1)%-16s %-9s %-8s %-9s %-17s %s$(c 0)\n" SESSION MACHINE ENGINE ACCOUNT CLOSED "CONVERSATION"
  sort -t$'\t' -k7 -r <<<"$recs" | awk -F'\t' '{printf "%-16s %-9s %-8s %-9s %-17s %s\n", $1, $2, $3, $4, $7, ($8!="" ? ($6!="" ? $6 : "(untitled)") : "—")}'
  echo; echo "Bring one back with: gwm resume <session>   ·   read one: gwm history <session>"
}
cmd_stop() { local n="$1"; need_session "$n"
  save_record "$(sfield "$n" 2)" "$n" "$(sfield "$n" 3)" "$(sfield "$n" 4)" "$(sfield "$n" 5)"
  run_script "$(sfield "$n" 2)" "$(archive_cmd "$n"); tmux kill-session -t '=$PFX$n' 2>/dev/null; echo 'stopped $n — its tab stays; press Enter there to start it fresh'"; }
cmd_who() {  # who is using which machine right now
  local data map; data="$(probe_all)"; map="$(ip_map)"
  while IFS=$'\t' read -r h _; do
    if [ -n "$(probe_line "$h" H "" "$data")" ]; then ub="$(used_by "$h" "$data" "$map")"; printf "%-12s %s\n" "$h" "${ub:-nobody else}"
    elif [ -n "$(probe_line "$h" A "" "$data")" ]; then printf "%-12s %s\n" "$h" "needs approval (Tailscale SSH check)"
    else printf "%-12s %s\n" "$h" "offline"; fi
  done < <(hosts)
}

# ---------- hosts ----------
cmd_run() { local h="$1"; shift; need_host "$h"; run_script "$h" "cd ~ && eval \"\$(printf %s $(b64 "$*") | base64 -d)\""; }
cmd_doctor() {  # check every host in parallel, printing in hosts.conf order
  local tmp i=0 h t role; tmp="$(mktemp -d)"
  while IFS=$'\t' read -r h t role; do
    i=$((i+1))
    ( out="$(run_script "$h" 'echo reach-ok; for x in tmux claude opencode omlx ollama limactl; do command -v $x >/dev/null && echo "$x-ok"; done; [ "$(uname)" = Darwin ] && pmset -g | awk "/ sleep /{print \"sleep=\"\$2}"' 2>&1)"
      { printf "$(c 1)%s$(c 0)  %s\n" "$h" "$(is_local "$h" && echo "(this machine)" || echo "$t")"
        if ! grep -q reach-ok <<<"$out"; then
          echo "  $(c 31)✗ unreachable:$(c 0) $(tail -1 <<<"$out")"
          case "$t" in vm:*) vm_split "$t"; echo "    → start it: gwm vm start $VM_NAME --on $VM_PARENT" ;;
            *) echo "    → on $h: System Settings → General → Sharing → Remote Login ON"
               echo "    → then on $h:  ssh $(hfield "$(self_name)" 2 2>/dev/null) cat .ssh/id_ed25519.pub >> ~/.ssh/authorized_keys" ;; esac
        else
          for x in tmux claude opencode omlx ollama limactl; do
            grep -q "^$x-ok" <<<"$out" && printf "  $(c 32)✓$(c 0) %s" "$x" || printf "  $(c 2)· %s$(c 0)" "$x"; done; echo
          s="$(grep sleep= <<<"$out" | cut -d= -f2)"
          [ -n "$s" ] && { [ "$s" = 0 ] && echo "  $(c 32)✓$(c 0) never sleeps" || echo "  $(c 33)•$(c 0) sleeps after $s min (servers: sudo pmset -a sleep 0)"; }
        fi; } > "$tmp/$(printf '%04d' "$i")" ) &
  done < <(hosts)
  wait; cat "$tmp"/* 2>/dev/null; rm -rf "$tmp"
}

# ---------- accounts ----------
cmd_accounts() {
  parse_on "$@"
  run_script "$ON" '
show() { s=$(env ${1:+CLAUDE_CONFIG_DIR="$1"} claude auth status 2>/dev/null)
  if echo "$s" | grep -q "\"loggedIn\": true"; then echo "logged in  $(echo "$s" | grep -o "\"email\": *\"[^\"]*\"" | cut -d\" -f4)"; else echo "not logged in"; fi; }
setopt NULL_GLOB 2>/dev/null || true
printf "%-12s %s\n" default "$(show "")"
for d in $HOME/.config/go-with-me/accounts/*/; do [ -d "$d" ] && printf "%-12s %s\n" "$(basename "$d")" "$(show "${d%/}")"; done'
}
cmd_login() {
  local a; parse_on "$@"; a="${ARGS[0]:-}"; [ -n "$a" ] || die "usage: gwm login <account> [--on host]"
  [[ "$a" =~ $NAME_RE ]] || die "account: letters, digits, _ . - only"
  if [ "$a" = default ]; then run_tty "$ON" "claude auth login"
  else run_tty "$ON" "mkdir -p $ACCT_DIR/$a && CLAUDE_CONFIG_DIR=$ACCT_DIR/$a claude auth login"; fi
}

# ---------- VMs ----------
cmd_vm() {
  local sub="${1:-list}"; shift || true; parse_on "$@"; local name="${ARGS[0]:-}" yes=""
  for x in "${ARGS[@]:-}"; do [ "$x" = --yes ] && yes=1; done
  [ -z "$name" ] || [[ "$name" =~ ^[A-Za-z0-9_-]+$ ]] || die "VM name: letters, digits, - and _ only"
  has_cmd "$ON" limactl || die "Lima isn't installed on $ON (run there: brew install lima)"
  case "$sub" in
    list)  run_script "$ON" "limactl list" ;;
    start|stop) [ -n "$name" ] || die "usage: gwm vm $sub <name> [--on host]"; run_script "$ON" "limactl $sub $name" ;;
    delete) [ -n "$name" ] || die "usage: gwm vm delete <name> [--on host]"
      if [ -z "$yes" ]; then
        [ -t 0 ] || die "add --yes to confirm deleting VM '$name'"
        printf "Delete VM '%s' on %s and everything inside it? [y/N] " "$name" "$ON"; read -r r; case "$r" in y|Y|yes) ;; *) echo Cancelled.; return;; esac
      fi
      run_script "$ON" "limactl delete --force $name" && {
        filter_conf "$HOSTS" 1 "$name" '^vm:'
        filter_conf "$SESSIONS" 2 "$name"
        echo "Deleted VM $name and removed it from your config."; } ;;
    create)
      [ -n "$name" ] || die "usage: gwm vm create <name> [--on host] [--cpus N] [--memory GB] [--disk GB]"
      local cpus=4 mem=8 disk=60 i=1
      while [ $i -lt ${#ARGS[@]} ]; do case "${ARGS[$i]}" in
        --cpus) cpus="${ARGS[$((i+1))]}";; --memory) mem="${ARGS[$((i+1))]}";; --disk) disk="${ARGS[$((i+1))]}";; esac; i=$((i+2)); done
      is_uint "$cpus" && is_uint "$mem" && is_uint "$disk" || die "--cpus, --memory and --disk must be positive integers"
      echo "Creating Linux VM '$name' on $ON ($cpus CPUs, ${mem}GB RAM, ${disk}GB disk). First time downloads Ubuntu (~600MB)…"
      run_script "$ON" "limactl create --name=$name --cpus=$cpus --memory=$mem --disk=$disk --tty=false template:default && limactl start $name" || die "VM creation failed"
      echo "Installing tmux, git and Claude Code inside the VM…"
      run_script "$ON" "limactl shell --workdir / $name -- bash -lc 'sudo apt-get update -qq && sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq tmux git curl >/dev/null && curl -fsSL https://claude.ai/install.sh | bash'"
      grep -q "^$name[[:space:]]*|" "$HOSTS" || printf '%-12s | vm:%s/%s | Linux VM on %s (%s CPU, %sGB)\n' "$name" "$ON" "$name" "$ON" "$cpus" "$mem" >> "$HOSTS"
      grep -q "^$name[[:space:]]*|" "$SESSIONS" || printf '%-14s | %-10s | claude   | default  | ~\n' "$name" "$name" >> "$SESSIONS"
      echo "Done. Added host + session '$name'. Sign Claude in inside it:  gwm login default --on $name"
      echo "Restart the hub to get its tab:  gwm kill && gwm" ;;
    *) die "usage: gwm vm create|list|start|stop|delete" ;;
  esac
}

