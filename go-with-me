cmd_opencode_setup() {
  parse_on "$@"; local model="" i=0
  while [ $i -lt ${#ARGS[@]} ]; do [ "${ARGS[$i]}" = --model ] && model="${ARGS[$((i+1))]}"; i=$((i+1)); done
  [ -z "$model" ] || [[ "$model" =~ $MODEL_RE ]] || die "invalid model name '$model'"
  run_script "$ON" "
f=\$HOME/.config/opencode/opencode.json; mkdir -p \$(dirname \$f); [ -f \$f ] && cp \$f \$f.bak
t=\$(mktemp); srv=ollama; k=\$(cat ~/.omlx/api_key 2>/dev/null); A=(); [ -n \"\$k\" ] && A=(-H \"Authorization: Bearer \$k\")
if curl -sf -m 2 \${A[@]+\"\${A[@]}\"} http://127.0.0.1:8000/v1/models > \$t.json; then srv=omlx
  python3 -c 'import json, sys; [print(m[\"id\"]) for m in json.load(open(sys.argv[1]))[\"data\"]]' \$t.json > \$t
else ollama list 2>/dev/null | awk 'NR>1{print \$1}' > \$t; fi
rm -f \$t.json
python3 - \"\$f\" '$model' \"\$t\" \"\$srv\" <<'PY'
import json, sys, os
path, want = sys.argv[1], sys.argv[2]
cfg = json.load(open(path)) if os.path.exists(path) else {}
models = [m.strip() for m in open(sys.argv[3]) if m.strip()]
cfg.setdefault('\$schema', 'https://opencode.ai/config.json')
prov = cfg.setdefault('provider', {})
srv = sys.argv[4]
prov.pop('lmstudio', None)
prov.pop('ollama' if srv == 'omlx' else 'omlx', None)
prov[srv] = {'npm': '@ai-sdk/openai-compatible', 'name': 'oMLX (local)' if srv == 'omlx' else 'Ollama (local)',
             'options': {'baseURL': 'http://127.0.0.1:8000/v1' if srv == 'omlx' else 'http://127.0.0.1:11434/v1'},
             'models': {m: {'name': m} for m in models}}
if srv == 'omlx' and os.path.exists(os.path.expanduser('~/.omlx/api_key')):
    prov[srv]['options']['apiKey'] = '{file:~/.omlx/api_key}'   # opencode reads the key file; the key is never copied
pick = want or next((m for m in models if 'inkling' in m), models[0] if models else '')
if pick: cfg['model'] = srv + '/' + pick
json.dump(cfg, open(path, 'w'), indent=2)
